<aside class="sidebar @(MenuOpen ? "sidebar--open" : "")" @onkeydown="HandleMenuKeyAsync">
    <div class="sidebar__header">
    <div class="sidebar__brand">
        <BrandLogo Reversed="true" />
    </div>

    <button class="sidebar__toggle" type="button" @ref="MenuToggle"
            aria-label="@(MenuOpen ? "Close menu" : "Open menu")"
            aria-expanded="@(MenuOpen ? "true" : "false")" aria-controls="mobile-navigation"
            @onclick="ToggleMenu">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            @if (MenuOpen) { <path d="m6 6 12 12M6 18 18 6"/> }
            else { <path d="M4 6h16M4 12h16M4 18h16"/> }
        </svg>
        <span>Menu</span>
    </button>
    </div>
    @if (MenuOpen)
    {
        <button class="sidebar__backdrop" type="button" tabindex="-1" aria-label="Close navigation" @onclick="CloseMenu" />
    }
    <div class="sidebar__panel" id="mobile-navigation">
    <nav class="sidebar__nav" aria-label="Main navigation" @onclick="CloseMenu">
        <NavLink href="/fleet/map">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z"/><path d="M9 3v15m6-12v15"/></svg><span>Fleet Map</span>
        </NavLink>

        <NavLink href="/dispatch"><ActionIcon Kind="truck" /><span>Dispatch</span></NavLink>
        <NavLink href="/customers"><ActionIcon Kind="contact" /><span>Customers &amp; brokers</span></NavLink>

        <AuthorizeView Roles="Admin">
            <NavLink href="/border">
                <ActionIcon Kind="location" /><span>Border</span>
            </NavLink>
            <NavLink href="/settings/fleet"><ActionIcon Kind="truck" /><span>Fleet</span></NavLink>
            <NavLink href="/users"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2m1-15a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 4v2"/></svg><span>Users</span></NavLink>
            <NavLink href="/settings" Match="NavLinkMatch.All"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 3 1-2h4l1 2 2 1 2-1 2 3-1 2v3l2 1v4l-2 1-1 2v2l-3 1-2-1h-3l-2 1-3-2 1-2-1-2-2-1v-4l2-1 1-2-1-2 3-2Z" transform="translate(1 1) scale(.88)"/><circle cx="12" cy="12" r="3"/></svg><span>Settings</span></NavLink>
        </AuthorizeView>
    </nav>

    <div class="sidebar__footer">
      <AuthorizeView Context="account">
        <button class="btn btn--sidebar sidebar__account" type="button" @ref="AccountToggle"
                aria-expanded="@(AccountOpen ? "true" : "false")" aria-controls="sidebar-account-actions"
                @onclick="ToggleAccount">
          <span class="sidebar__avatar" aria-hidden="true">@AccountInitials(account.User)</span>
          <span class="sidebar__account-text"><strong>@AccountName(account.User)</strong><span>@(account.User.IsInRole("Admin") ? "Administrator" : "Dispatch")</span></span>
          <svg class="sidebar__account-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 14 4-4 4 4" /></svg>
        </button>
      @if (AccountOpen)
      {
      <div id="sidebar-account-actions" role="group" aria-label="Account actions">
      <NavLink href="/settings/personal" class="btn btn--sidebar"
               @onclick="CloseMenu">
          <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 7h16M4 17h16M8 4v6m8 4v6" />
          </svg>Personal settings
      </NavLink>
      <button
          class="btn btn--sidebar"
          type="button"
          @onclick="LogoutAsync">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4H4v16h6M14 8l4 4-4 4M8 12h12" /></svg>Logout
      </button>
      </div>
      }
      </AuthorizeView>
    </div>
    </div>
</aside>
