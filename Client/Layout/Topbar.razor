@using System.Globalization
@using Client.Shared.Brand.BrandLogo
@* The wide-screen bar over the rail: the product, where the reader is,
   the theme, the time and the account. Phones keep the navigation's own
   head instead. *@
<header class="topbar">
    <a class="topbar__brand" href="/fleet/map" aria-label="PulsR TMS home">
        <BrandLogo />
    </a>
    <nav class="topbar__crumbs" aria-label="Context">
        <span>@Place.Section</span><span aria-hidden="true">/</span>
        <b>@Place.Page</b>
    </nav>
    <span class="topbar__spacer"></span>
    @if (Appearance is { } appearance)
    {
        <button type="button" class="topbar__icon-button"
                aria-label="@(appearance.Theme == "dark"
                    ? "Use the light theme" : "Use the dark theme")"
                title="Theme" disabled="@appearance.Busy"
                @onclick="ToggleThemeAsync">
            <ActionIcon Kind="@(appearance.Theme == "dark" ? "sun" : "moon")" />
        </button>
    }
    <div class="topbar__clock" aria-hidden="true">
        <ActionIcon Kind="clock" />
        <div>
            <div class="topbar__date">@_now.ToString("ddd, MMM d",
                CultureInfo.InvariantCulture)</div>
            <div class="topbar__time">@_now.ToString("h:mm tt",
                CultureInfo.InvariantCulture)</div>
        </div>
    </div>
    <AccountMenu Block="topbar" />
</header>
