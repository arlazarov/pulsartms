@page "/messages"
@page "/messages/{Id:guid}"
@attribute [Authorize(Roles = "Admin,Dispatch")]
@using Client.Models.DTO.Messaging

<PageTitle>Messages · PulsR</PageTitle>

<section class="messages-page @(Id is null ? "is-list" : "is-thread") @(_trip ? "shows-trip" : "")">
    <PageHeader Title="Messages">
        <NotificationChoice />
    </PageHeader>
    @if (_error is not null)
    {
        <p class="settings-page__error" role="alert">
            @_error
            <button class="btn btn--small" type="button"
                    @onclick="ReloadAsync">
                Reload messages
            </button>
        </p>
    }
    <div class="messages">
        <aside class="messages__list" aria-label="Conversations">
            <div class="messages__list-head">
                <form class="messages__search" role="search"
                      @onsubmit="SearchAsync">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="M20 20l-4-4" />
                    </svg>
                    <input type="search" aria-label="Search conversations"
                           placeholder="Driver name or number"
                           maxlength="100" @bind="_search" />
                </form>
                <div class="messages__filters" role="group" aria-label="Show">
                    <button type="button" class="messages__chip"
                            aria-pressed="@(_unreadOnly ? "false" : "true")"
                            @onclick="() => FilterAsync(false)">
                        All
                    </button>
                    <button type="button" class="messages__chip"
                            aria-pressed="@(_unreadOnly ? "true" : "false")"
                            @onclick="() => FilterAsync(true)">
                        Unread
                    </button>
                </div>
                <DriverGroupPicker Id="messages-driver-group" />
            </div>
            <div class="messages__rows">
                @if (_conversations is null)
                {
                    <p role="status"><LoadingIndicator /></p>
                }
                else if (_conversations.Count == 0)
                {
                    <p class="messages__empty">
                        @(_searched.Length > 0
                            ? "No conversation matches."
                            : _unreadOnly
                            ? "Nothing unread."
                            : "No conversation yet.")
                    </p>
                }
                else
                {
                    <ul class="messages__conversations">
                        @foreach (var item in _conversations)
                        {
                            <li @key="item.Id">
                                <a href="@($"/messages/{item.Id}")"
                                   class="@Conversation(item)"
                                   aria-current="@(item.Id == Id ? "page" : null)">
                                    <span class="messages__avatar" aria-hidden="true">@Initials(item)</span>
                                    <span class="messages__who">
                                        <strong>@Who(item)</strong>
                                    </span>
                                    <time datetime="@Stamp(item.LastMessageAt)">
                                        @When(item.LastMessageAt)
                                    </time>
                                    <span class="messages__preview">
                                        @(item.LastPreview.Length > 0
                                            ? item.LastPreview
                                            : "No messages yet")
                                    </span>
                                    @if (item.Unread > 0)
                                    {
                                        <span class="messages__unread"
                                              aria-label="@Unread(item)">
                                            @item.Unread
                                        </span>
                                    }
                                    @if (Colleague(item) || !item.WindowOpen)
                                    {
                                        <span class="messages__tags">
                                            @if (Colleague(item))
                                            {
                                                <span class="messages__tag is-claim">
                                                    @item.ClaimedBy is replying
                                                </span>
                                            }
                                            @if (!item.WindowOpen)
                                            {
                                                <span class="messages__tag is-window">Template only</span>
                                            }
                                        </span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                    @if (_next is not null)
                    {
                        <button type="button" class="btn btn--small btn--text messages__more"
                                disabled="@_loadingMore"
                                @onclick="LoadMoreAsync">
                            Show more conversations
                        </button>
                    }
                }
                @if (!_unreadOnly)
                {
                    <MessagingDrivers Search="@_searched" OnOpened="ChatOpened" />
                }
            </div>
        </aside>
        <section class="messages__thread" aria-label="Conversation"
                 @ref="_threadPane">
            @if (_thread is null && Id is null)
            {
                <p class="messages__empty">Choose a conversation.</p>
            }
            else if (_thread is null)
            {
                <p class="messages__empty" role="status"><LoadingIndicator /></p>
            }
            else
            {
                var summary = _thread.Summary;
                <header class="messages__head">
                    <a href="/messages"
                       class="btn btn--small btn--text messages__back">
                        ‹ Back
                    </a>
                    <span class="messages__avatar" aria-hidden="true">@Initials(summary)</span>
                    <span class="messages__title">
                        <h2>@Who(summary)</h2>
                        <span>
                            @if (_context?.Trucks.Count == 1)
                            {
                                <text>Truck @_context.Trucks[0].Number</text>
                                @if (_context.Loads.FirstOrDefault() is { } load)
                                {
                                    <text> · </text><LoadNumber Value="load.LoadNumber" />
                                    @if (load.Status is { } status)
                                    {
                                        <text> · @Titled(status)</text>
                                    }
                                }
                            }
                            else
                            {
                                @summary.Participant
                            }
                        </span>
                        @if (Glance(_context?.Hours) is { } glance)
                        {
                            <span class="messages__glance">@glance</span>
                        }
                    </span>
                    <button type="button" class="messages__search-toggle"
                            aria-label="Search messages" title="Search messages"
                            aria-expanded="@(_searchOpen ? "true" : "false")"
                            @onclick="() => _searchOpen = !_searchOpen">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="7" />
                            <path d="M20 20l-4-4" />
                        </svg>
                    </button>
                    <button type="button" class="btn btn--small messages__trip"
                            aria-expanded="@(_trip ? "true" : "false")" aria-controls="messages-trip"
                            @onclick="() => _trip = !_trip">
                        Trip
                    </button>
                </header>
                @if (summary.ClaimedBy is { } by && by != _me)
                {
                    <p class="messages__banner is-claim">
                        <strong>@by</strong>&nbsp;started a reply. Yours still
                        goes if you send; read theirs first.
                    </p>
                }
                @if (_searchOpen)
                {
                    <MessageSearch ConversationId="Id" OnOpen="OpenHit"
                                   OnClose="() => _searchOpen = false" />
                }
                @if (_contextView)
                {
                    <p class="messages__banner">
                        Showing messages around a search result.
                        <button type="button" class="btn btn--small btn--text"
                                @onclick="JumpToNewest">
                            Jump to newest
                        </button>
                    </p>
                }
                <div class="messages__scroll" @ref="_scroller">
                    <ol class="messages__items">
                        @if (_loadingOlder)
                        {
                            <li class="messages__earlier" role="status">
                                <LoadingIndicator />
                            </li>
                        }
                        else if (_olderFailed)
                        {
                            <li class="messages__earlier" role="alert">
                                Earlier messages could not be loaded.
                                <button type="button"
                                        class="btn btn--small btn--text"
                                        @onclick="OlderAsync">
                                    Try again
                                </button>
                            </li>
                        }
                        else if (_thread.Older)
                        {
                            <li class="messages__earlier">
                                <button type="button"
                                        class="btn btn--small btn--text"
                                        @onclick="OlderAsync">
                                    Show earlier messages
                                </button>
                            </li>
                        }
                        else if (_messages.Count > 0)
                        {
                            <li class="messages__earlier messages__start">
                                Start of the conversation
                            </li>
                        }
                        @foreach (var (message, day) in Days())
                        {
                            @if (day is not null)
                            {
                                <li class="messages__day" @key="day">@day</li>
                            }
                            <MessageItem @key="message.Id" Message="message"
                                         Busy="_busy" OnOpen="OpenAsync"
                                         OnRetry="RetryAsync" Loads="Suggestions"
                                         Me="@_me"
                                         OnFiled="() => FiledAsync(summary.Id)" />
                        }
                    </ol>
                </div>
                @if (_newBelow)
                {
                    <button type="button" class="messages__new-below"
                            @onclick="ToNewestAsync">
                        New messages
                        <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 3v10M4 9l4 4 4-4" />
                        </svg>
                    </button>
                }
                <p class="visually-hidden" role="status">
                    @(_newBelow ? "New messages below." : "")
                </p>
                @if (summary.WindowOpen)
                {
                    <form class="messages__composer" @onsubmit="SendAsync"
                          @onsubmit:preventDefault>
                        @if (_refusal is not null)
                        {
                            <div class="messages__guard" role="alert">
                                <span>@_refusal</span>
                                @if (_stale)
                                {
                                    <span class="messages__actions">
                                        <button type="button"
                                                class="btn btn--small btn--primary"
                                                disabled="@_busy"
                                                @onclick="SendAnywayAsync">
                                            Send anyway
                                        </button>
                                    </span>
                                }
                            </div>
                        }
                        <p class="messages__window">
                            <svg viewBox="0 0 16 16" aria-hidden="true">
                                <circle cx="8" cy="8" r="6" />
                                <path d="M8 4.5V8l2 1.5" />
                            </svg>
                            @FreeFor(summary)
                        </p>
                        @if (Staged.Any())
                        {
                            <ul class="messages__staged" aria-label="Files to send" data-staged>
                                @foreach (var file in Staged)
                                {
                                    <li @key="file.Id" class="@StagedClass(file)">
                                        @if (file.Preview is { } preview)
                                        {
                                            <img src="@preview" alt="" />
                                        }
                                        else
                                        {
                                            <span class="messages__staged-kind" aria-hidden="true">@file.Kind</span>
                                        }
                                        <span class="messages__staged-name">@file.Name</span>
                                        <span class="messages__staged-size">
                                            @file.Kind · @file.Size
                                        </span>
                                        @if (file.State == StagedState.Sending)
                                        {
                                            <span class="messages__staged-progress" role="progressbar"
                                                  aria-label="@($"Sending {file.Name}")"></span>
                                        }
                                        else if (file.State == StagedState.Failed)
                                        {
                                            <span class="messages__staged-error" role="alert">@file.Error</span>
                                            <button type="button" class="btn btn--small btn--text"
                                                    disabled="@_busy"
                                                    @onclick="() => RetryFileAsync(file)">
                                                Send again
                                            </button>
                                        }
                                        @if (file.State != StagedState.Sending)
                                        {
                                            <button type="button" class="messages__staged-remove"
                                                    aria-label="@($"Remove {file.Name}")"
                                                    @onclick="() => Unstage(file)">
                                                <svg viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M4 4l8 8M12 4l-8 8" />
                                                </svg>
                                            </button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        <div class="messages__compose-row">
                            <label class="messages__attach" title="Attach PDFs or photos">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M20 12l-8 8a5 5 0 0 1-7-7l9-9a3.5 3.5 0 0 1 5 5l-9 9a2 2 0 0 1-3-3l8-8" />
                                </svg>
                                <InputFile OnChange="StageAsync" disabled="@_busy"
                                           accept="@Accepted" multiple
                                           data-drop-target
                                           aria-label="Attach files" />
                            </label>
                            <label for="messages-text" class="visually-hidden">
                                Message to @Who(summary)
                            </label>
                            <textarea id="messages-text" rows="1" maxlength="4096"
                                      data-send-on-enter aria-keyshortcuts="Enter"
                                      title="Enter sends; Option+Enter starts a new line"
                                      @bind="_draft" @bind:event="oninput"
                                      @onfocus="ClaimAsync" disabled="@_busy"
                                      placeholder="@($"Message {FirstName(summary)}")"></textarea>
                            <button type="submit" class="btn btn--primary"
                                    disabled="@(!CanSend)">
                                Send
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="messages__composer">
                        <div class="messages__template-box">
                            <div class="messages__contact">
                                @if (ContactTemplate is not null)
                                {
                                    <button type="button" class="btn btn--small btn--primary"
                                            disabled="@_busy" @onclick="RequestContactAsync">
                                        Request contact
                                    </button>
                                    <span class="messages__note">
                                        Asks the driver to reply when it is safe;
                                        they can answer with one tap.
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn--small" disabled>
                                        Request contact
                                    </button>
                                    <span class="messages__note">
                                        Waiting for approval: the contact request
                                        template is not recorded as approved for
                                        this number yet.
                                    </span>
                                }
                            </div>
                            @if (summary.LastInboundAt is null)
                            {
                                <p>
                                    <strong>No reply window yet.</strong>
                                    @FirstName(summary) has not written to this
                                    number, so WhatsApp only delivers an
                                    approved template first. The reply box
                                    opens as soon as the driver answers.
                                </p>
                            }
                            else
                            {
                                <p>
                                    <strong>Outside the 24-hour window.</strong>
                                    @FirstName(summary) last wrote more than a
                                    day ago, so WhatsApp only delivers an
                                    approved template. The reply box opens as
                                    soon as the driver answers.
                                </p>
                            }
                            @if (!DispatcherTemplates.Any())
                            {
                                <p class="messages__note">
                                    No template is approved yet, so nothing can
                                    be sent until the driver writes.
                                </p>
                            }
                            else
                            {
                                <label for="messages-template">
                                    Template
                                    <select id="messages-template"
                                            @bind="_template" disabled="@_busy">
                                        <option value="">Choose a template</option>
                                        @foreach (var template in DispatcherTemplates)
                                        {
                                            <option value="@template.Name">
                                                @template.Name
                                            </option>
                                        }
                                    </select>
                                </label>
                                @if (Chosen is { } chosen)
                                {
                                    <p class="messages__note">@chosen.Text</p>
                                    @for (var i = 0; i < chosen.Parameters; i++)
                                    {
                                        var index = i;
                                        <label for="@ParameterId(index)">
                                            @Placeholder(index)
                                            <input id="@ParameterId(index)"
                                                   maxlength="200"
                                                   value="@Parameter(index)"
                                                   @onchange="e => SetParameter(
                                                       index,
                                                       e.Value?.ToString())" />
                                        </label>
                                    }
                                    <span class="messages__actions">
                                        <button type="button" class="btn btn--small btn--primary"
                                                disabled="@(_busy || !TemplateReady)"
                                                @onclick="SendTemplateAsync">
                                            Send template
                                        </button>
                                    </span>
                                }
                            }
                            @if (_refusal is not null)
                            {
                                <p class="settings-page__error" role="alert">
                                    @_refusal
                                    @if (_stale)
                                    {
                                        <button type="button" class="btn btn--small"
                                                disabled="@_busy"
                                                @onclick="SendAnywayAsync">
                                            Send anyway
                                        </button>
                                    }
                                </p>
                            }
                        </div>
                    </div>
                }
            }
        </section>
        @if (_thread is not null)
        {
            <ConversationContextPanel @key="_thread.Summary.Id"
                                      ConversationId="_thread.Summary.Id"
                                      Participant="@_thread.Summary.Participant"
                                      Revision="_thread.Summary.Revision"
                                      Context="_context"
                                      Failed="_contextFailed"
                                      OnChanged="ContextChangedAsync"
                                      OnClose="() => _trip = false" />
            <button type="button" class="messages__backdrop" tabindex="-1"
                    aria-label="Close the trip" @onclick="() => _trip = false"></button>
        }
        else
        {
            <aside class="messages__context is-empty" aria-label="Driver and trip">
                <p class="messages__empty">The driver's hours and load show here.</p>
            </aside>
        }
    </div>
</section>
