<section class="dispatch-load @(Current && !Completed ? "dispatch-load--current" : "") @(Next ? "dispatch-load--next" : "")" aria-label="@($"Load {LoadLabel}")">
    <span class="dispatch-load__connector" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></span>
    @* The load as the map's truck card names it: its number, a link to its
       page, and its order; then who it is for, where it stands and which of
       the truck's loads it is. *@
    <div class="dispatch-load__heading">
        <a class="dispatch-load__number" href="@LoadUrl"
           aria-label="@($"Open load {LoadLabel}")">
            <LoadNumber Value="Load.LoadNumber" /><ActionIcon
                Kind="external-link" />
        </a>
        @if (!string.IsNullOrWhiteSpace(Load.OrderNumber))
        {
            <button type="button" class="btn btn--text btn--small dispatch-load__order" title="@(_copied ? "Copied" : "Copy order number")"
                    aria-label="Copy order number" @onclick="CopyOrderAsync">Order <strong>@Load.OrderNumber</strong>
                <svg class="dispatch-load__copy-icon @(_copied ? "is-copied" : "")" viewBox="0 0 20 20" aria-hidden="true">
                    @if (_copied) { <path d="m4 10 4 4 8-8" /> }
                    else { <rect x="6" y="6" width="10" height="11" rx="2" /><path d="M4 13H3V3h10v1" /> }
                </svg>
            </button>
        }
    </div>
    @if (_copyError is not null) { <span class="dispatch-load__copy-error" role="alert">@_copyError</span> }
    <div class="dispatch-load__reference">
        <span>@Load.CustomerName</span>
        <span class="dispatch-load__status @(!Completed && Load.Status == "in_transit" ? "is-moving" : "")">@Status</span>
        <span class="dispatch-load__phase">@Phase</span>
    </div>
    @* Every load names its own driver and trailer: they change from load
       to load on one truck (the owner, September 27). *@
    <div class="dispatch-load__meta">
        <span class="dispatch-load__assignment">Driver <strong>@DispatchBoardRow.Text(Load.DriverName)</strong></span>
        <span class="dispatch-load__assignment">Trailer <strong>@DispatchBoardRow.Text(Load.TrailerNumber)</strong></span>
    </div>
    @* The rate and both rates per mile, as the server reports them. *@
    <div class="dispatch-load__meta dispatch-load__money">
        <span class="dispatch-load__figure">Rate <strong>@DispatchFinancialDisplay.Money(Load.Price, Load.Currency)</strong></span>
        <span class="dispatch-load__figure">Loaded RPM <strong>@DispatchFinancialDisplay.Money(Load.LoadedRatePerMile, Load.Currency)</strong></span>
        <span class="dispatch-load__figure">Total RPM <strong>@DispatchFinancialDisplay.Money(Load.TotalRatePerMile, Load.Currency)</strong></span>
    </div>
    <div class="dispatch-load__overview">
        @if (OrderedStops.Count > 2) { <p class="dispatch-load__stop-summary">@StopSummary</p> }
        <ol class="dispatch-load__route @(CompletedStopCount > 0 ? "has-history" : "")" style="@($"--completed-stop-count: {Math.Max(1, CompletedStopCount)}")" aria-label="Stops and arrival estimates">
            @foreach (var visit in StopVisits)
            {
                var stop = visit.Stop;
                <li @key="(Load.Id, stop.Id, stop.Sequence, DispatchStopPresentation.CompletionRevision(Load.Stops))" class="dispatch-load__route-stop @(stop.IsCompleted || Completed && !stop.DriverOnly ? "is-history" : "is-remaining")">
                    <DispatchLoadStop DispatchId="Load.Id" Stop="stop" Number="visit.Number" VisitLabel="@visit.VisitLabel"
                        FallbackDate="FallbackDate(stop)" Eta="Load.Eta"
                        Refreshing="Refreshing" CompletedLoad="Completed"
                        Detailed="false" DetailsHref="@StopUrl(stop.Id)" />
                </li>
            }
        </ol>
        @if (OrderedStops.Count == 0) { <p class="dispatch-load__empty">Stops not provided</p> }
    </div>
    <footer class="dispatch-load__footer">
        @if (ShowRemaining) { <span class="dispatch-load__remaining"><DistanceText Miles="RemainingMiles" /> remaining</span> }
        @if (ShowFuelStops) { <span class="dispatch-load__fuel-count"><ActionIcon Kind="fuel" /> Fuel stops <strong>@FuelStopCount</strong></span> }
        @if (!ShowRemaining && !ShowFuelStops) { <span>@(OrderedStops.Count == 1 ? "1 stop" : $"{OrderedStops.Count} stops")</span> }
    </footer>
</section>
