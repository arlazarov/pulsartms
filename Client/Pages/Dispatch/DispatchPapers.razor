<div class="dispatch-papers-workspace">
    <div class="dispatch-papers @(Completed ? "dispatch-papers--completed" : "")">
    @for (var column = 0; column < Titles.Length; column++)
    {
        var rows = _columns[column];
        <section class="dispatch-paper-column dispatch-paper-column--@column" aria-label="@Titles[column]">
            <header class="dispatch-paper-column__heading"><h2>@Titles[column]</h2><span>@rows.Count</span></header>
            @if (rows.Count == 0) { <div class="dispatch-paper-column__empty">No loads in this folder</div> }
            else
            {
                <div class="dispatch-paper-tabs">
                @foreach (var row in rows)
                {
                    var phase = Phase(row);
                    <div @key="row.Key" class="dispatch-paper-tab-entry">
                        <a class="dispatch-paper__tab"
                           href="@($"/dispatch/{row.Load.Id}")"
                           aria-label="@($"Open load {LoadLabel(
                               row.Load.LoadNumber)}")">
                            <svg class="dispatch-paper__folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 5a1 1 0 0 1 1-1h5l2 3h9a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" /></svg>
                            <span class="dispatch-paper__tab-content">
                                @if (!string.IsNullOrEmpty(phase)
                                    && phase != row.Status)
                                {
                                    <span class="dispatch-paper__phase">
                                        @phase
                                    </span>
                                }
                                <span class="dispatch-paper__tab-line"><strong class="dispatch-paper__tab-number"><LoadNumber Value="row.Load.LoadNumber" /></strong><span class="dispatch-paper__tab-equipment">Truck @row.TruckNumber</span><span class="dispatch-paper__tab-schedule" aria-label="@($"{EventLabel(row)} {EventSchedule(row)}")">@EventSchedule(row)</span></span>
                                <span class="dispatch-paper__tab-line"><span class="dispatch-paper__tab-driver">@row.DriverName</span><span class="dispatch-paper__tab-status @(row.Completed ? "is-completed" : row.InTransit ? "is-moving" : "")">@row.Status</span></span>
                                <span class="dispatch-paper__tab-financials"><strong class="dispatch-paper__tab-miles"><DistanceText Miles="@((double?)row.Load.TotalMiles)" /> total</strong><span>@DispatchFinancialDisplay.Money(row.Load.Price, row.Load.Currency) · Total RPM @DispatchFinancialDisplay.Money(row.Load.TotalRatePerMile, row.Load.Currency)</span></span>
                            </span>
                        </a>
                    </div>
                }
                </div>
            }
        </section>
    }
    </div>
</div>
