<div class="dispatch-papers-workspace">
    <div class="dispatch-papers">
    @for (var column = 0; column < Titles.Length; column++)
    {
        var rows = _columns[column];
        <section class="dispatch-paper-column dispatch-paper-column--@column" aria-label="@Titles[column]">
            <header class="dispatch-paper-column__heading"><h2>@Titles[column]</h2><span>@rows.Count</span></header>
            @if (rows.Count == 0) { <div class="dispatch-paper-column__empty">No loads in this folder</div> }
            else
            {
                @foreach (var (dayTitle, dayRows) in Days(column))
                {
                @if (dayTitle is not null)
                {
                    <h3 class="dispatch-paper-column__day">@dayTitle
                        <span>@dayRows.Count</span></h3>
                }
                <div class="dispatch-paper-tabs">
                @foreach (var row in dayRows)
                {
                    var phase = Phase(row);
                    <div @key="row.Key" class="dispatch-paper-tab-entry">
                        @* The number opens the load; it and the order copy
                           beside it, and a link cannot hold buttons, so the
                           folder itself is no longer one link (the owner,
                           September 28). *@
                        <div class="dispatch-paper__tab">
                            <svg class="dispatch-paper__folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 5a1 1 0 0 1 1-1h5l2 3h9a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" /></svg>
                            <span class="dispatch-paper__tab-content">
                                @if (!string.IsNullOrEmpty(phase)
                                    && phase != row.Status)
                                {
                                    <span class="dispatch-paper__phase">
                                        @phase
                                    </span>
                                }
                                <span class="dispatch-paper__tab-line">
                                    <span class="dispatch-paper__tab-identity">
                                        <a class="dispatch-paper__tab-number"
                                           href="@LoadUrl(row)"
                                           aria-label="@($"Open load {LoadLabel(
                                               row.Load.LoadNumber)}")"><LoadNumber Value="row.Load.LoadNumber" /></a>
                                        <CopyValue Value="@LoadLabel(row.Load.LoadNumber)"
                                                   Title="Copy the load number"
                                                   Class="dispatch-paper__copy"><span aria-hidden="true">⧉</span><span class="visually-hidden">Copy the load number</span></CopyValue>
                                        @if (!string.IsNullOrWhiteSpace(row.Load.OrderNumber))
                                        {
                                            <span class="dispatch-paper__order">Order
                                                <CopyValue Value="@row.Load.OrderNumber"
                                                           Title="Copy the order number"
                                                           Class="dispatch-paper__copy dispatch-paper__order-value">@row.Load.OrderNumber</CopyValue></span>
                                        }
                                    </span>
                                    <span class="dispatch-paper__tab-schedule"
                                          aria-label="@($"{EventLabel(row)} appointment {EventSchedule(row)}")"><small class="dispatch-paper__event @EventTone(row)">@EventLabel(row)</small>@EventSchedule(row)</span>
                                </span>
                                @* Truck, trailer and driver on one row, folding
                                   whole on a narrow folder. *@
                                <span class="dispatch-paper__tab-units">
                                    <span class="dispatch-paper__tab-equipment">Truck @row.TruckNumber</span>
                                    <span class="dispatch-paper__tab-equipment dispatch-paper__tab-trailer">Trailer @row.TrailerNumber</span>
                                    <span class="dispatch-paper__tab-driver">@row.DriverName</span>
                                </span>
                                <span class="dispatch-paper__tab-route">@DispatchBoardRow.Location(row.Origin) → @DispatchBoardRow.Location(row.Destination)</span>
                                <span class="dispatch-paper__tab-line"><span></span><span class="dispatch-paper__tab-status @row.StatusTone">@row.Status</span></span>
                                <span class="dispatch-paper__tab-financials"><strong class="dispatch-paper__tab-miles"><DistanceText Miles="@((double?)row.Load.TotalMiles)" /> total</strong><span>@DispatchFinancialDisplay.Money(row.Load.Price, row.Load.Currency) · @DispatchFinancialDisplay.LoadedRpm @DispatchFinancialDisplay.Amount(row.Load.LoadedRatePerMile) · @DispatchFinancialDisplay.TotalRpm @DispatchFinancialDisplay.Amount(row.Load.TotalRatePerMile)</span></span>
                            </span>
                        </div>
                    </div>
                }
                </div>
                }
            }
        </section>
    }
    </div>
</div>
