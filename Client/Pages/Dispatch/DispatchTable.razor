<div class="dispatch-table-wrap" role="region" aria-label="Dispatch load table" tabindex="0">
<table class="dispatch-table">
    <caption class="visually-hidden">Dispatches on this page</caption>
    <colgroup><col class="dispatch-table__column-load" /><col class="dispatch-table__column-truck" /><col class="dispatch-table__column-stop" span="2" /><col class="dispatch-table__column-miles" /><col class="dispatch-table__column-money" /></colgroup>
    <thead><tr><th scope="col">Load / status</th><th scope="col">Truck / driver</th><th scope="col">@(HasOtherStops ? "Pickup / other stops" : "Pickup")</th><th scope="col">Delivery</th><th scope="col">Distance</th><th scope="col" class="dispatch-table__money">Rate / RPM</th></tr></thead>
    @foreach (var day in _days)
    {
    <tbody class="dispatch-table__day-group">
    <tr class="dispatch-table__day"><th colspan="6" scope="rowgroup">@day.Label</th></tr>
    @foreach (var row in day.Rows)
    {
        var phase = Phase(row);
        var visits = DispatchStopPresentation.OrderedVisits(row.Load.Stops);
        <tr @key="row.Key" class="dispatch-table__row @(phase == "Current" ? "is-current" : phase == "Next" ? "is-next" : row.Planned ? "is-planned" : "")" @onclick="e => OpenFromRow(row, e)">
            <td class="dispatch-table__load">
                <a class="dispatch-table__open" href="@LoadUrl(row)"
                   aria-label="@($"Open load {LoadLabel(row.Load.LoadNumber)}")"
                   @onclick:stopPropagation="true">
                    <strong><LoadNumber Value="row.Load.LoadNumber" /></strong><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                </a>
                <div class="dispatch-table__labels">
                    @if (!string.IsNullOrEmpty(phase) && phase != row.Status) { <span class="dispatch-table__phase @(phase == "Current" ? "is-current" : phase == "Next" ? "is-next" : "")">@phase</span> }
                    <span class="dispatch-table__status @(row.Completed ? "is-completed" : row.InTransit ? "is-moving" : "")">@row.Status</span>
                </div>
                <span class="dispatch-table__customer">@DispatchBoardRow.Text(row.Load.CustomerName)</span>
                @if (!string.IsNullOrWhiteSpace(row.Load.OrderNumber)) { <small class="dispatch-table__order">Order @row.Load.OrderNumber</small> }
            </td>
            <td class="dispatch-table__equipment">
                <div class="dispatch-table__truck"><strong>Truck @row.TruckNumber</strong>@if ((row.Load.TruckId ?? row.Truck.TruckId).HasValue) { <a class="dispatch-table__map" href="@row.MapUrl" aria-label="@($"View {LoadLabel(row.Load.LoadNumber)} on map")" @onclick:stopPropagation="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a> }</div>
                <span>@row.DriverName</span><small class="dispatch-table__trailer">Trailer @row.TrailerNumber</small>
            </td>
            @foreach (var pickup in new[] { true, false })
            {
                var stops = Stops(visits, pickup);
                <td class="dispatch-table__stop @(pickup ? "is-pickup" : "is-delivery")">
                    @if (stops.Count > 1)
                    {
                        <a class="btn btn--text btn--small
                            dispatch-table__stops-summary"
                           href="@LoadUrl(row)"
                           aria-label="@($"View all stops for {LoadLabel(
                               row.Load.LoadNumber)}")"
                           @onclick:stopPropagation="true">
                            @StopSummary(row, stops, pickup)
                        </a>
                    }
                    @if (SummaryVisit(row, stops) is { } visit)
                    {
                        var stop = visit.Stop;
                        <div @key="stop.Id" class="dispatch-table__stop-entry" data-stop-id="@stop.Id">
                            @if (stops.Count > 1) { <small class="dispatch-table__stop-context">@(StopCompleted(row, stop) ? "Last" : "Next") · @stop.Job</small> }
                            else if (!IsPickup(stop) && !IsDelivery(stop)) { <small>@stop.Job</small> }
                            @if (visits.Count > 2)
                            {
                                <small class="dispatch-table__stop-position">Stop @visit.Number@if (visit.VisitCount > 1) { <span title="@($"{visit.VisitLabel} at this address")"> · @visit.VisitLabel</span> }</small>
                            }
                            <strong>@DispatchBoardRow.Location(stop)</strong>
                            <small class="dispatch-table__schedule">@DispatchBoardRow.Schedule(stop, pickup ? row.Load.ShipDate : row.Load.DeliveryDate)</small>
                            @if (StopCompleted(row, stop)) { <span class="dispatch-table__stop-completed"><span aria-hidden="true">✓</span> Completed</span> }
                            @if (stop.StateAfter is not ("Unknown" or "Loaded")) { <small>After: @stop.StateAfter</small> }
                            @if (!string.IsNullOrWhiteSpace(stop.Name) && string.IsNullOrWhiteSpace(stop.Address)) { <small class="dispatch-table__facility">@stop.Name</small> }
                            @if (!string.IsNullOrWhiteSpace(stop.Address) && !string.IsNullOrWhiteSpace(stop.City)) { <small class="dispatch-table__street">@stop.Address</small> }
                        </div>
                    }
                    @if (stops.Count == 0) { <div class="dispatch-table__stop-entry"><strong>Pending</strong><small class="dispatch-table__schedule">@DispatchBoardRow.Schedule(null, pickup ? row.Load.ShipDate : row.Load.DeliveryDate)</small></div> }
                </td>
            }
            <td class="dispatch-table__mileage">
                <dl class="dispatch-table__distances">
                    <div><dt>Loaded</dt><dd>@Distance(row.Load.LoadedMiles)</dd></div>
                    <div><dt>Empty</dt><dd>@Distance(row.Load.EmptyMiles)</dd></div>
                    <div class="is-total"><dt>Total</dt><dd>@Distance(row.Load.TotalMiles)</dd></div>
                </dl>
                <small>@row.Load.Stops.Count stops</small>
            </td>
            @* The rate and both rates per mile in one column, named as the
               distances are (the owner, September 27). *@
            <td class="dispatch-table__money">
                <dl class="dispatch-table__figures">
                    <div><dt>Rate</dt><dd>@DispatchFinancialDisplay.Money(row.Load.Price, row.Load.Currency)</dd></div>
                    <div><dt>@DispatchFinancialDisplay.LoadedRpm</dt><dd>@DispatchFinancialDisplay.Money(row.Load.LoadedRatePerMile, row.Load.Currency)</dd></div>
                    <div class="is-total"><dt>@DispatchFinancialDisplay.TotalRpm</dt><dd>@DispatchFinancialDisplay.Money(row.Load.TotalRatePerMile, row.Load.Currency)</dd></div>
                </dl>
            </td>
        </tr>
    }
    </tbody>
    }
    <tbody>
    @foreach (var truck in Trucks.Where(x => x.Dispatches.Count == 0))
    {
        <tr @key="truck.Key"><td>No active load</td><td class="dispatch-table__equipment"><strong>Truck @DispatchBoardRow.Text(truck.TruckNumber)</strong><span>@DispatchBoardRow.Text(truck.DriverName)</span><small>Trailer @DispatchBoardRow.Text(truck.TrailerNumber)</small></td><td colspan="4">Ready for assignment</td></tr>
    }
    </tbody>
</table>
</div>

@code {
    // A distance as whole words: the miles, then the kilometres beside
    // them, each kept whole.
    private RenderFragment Distance(decimal? value) =>
        @<text>@if (value is { } miles)
        {
            <span>@Units.DistanceValue((double)miles)&#160;@Units.DistanceUnit</span>@if (Units.BothDistances)
            {<small>@Units.Kilometers((double)miles)&#160;km</small>}
        }
        else
        {
            <span>—</span>
        }</text>;
}
