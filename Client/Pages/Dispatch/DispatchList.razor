@page "/dispatch"
@attribute [Authorize]
@using Client.Models.DTO.Dispatch

<PageTitle>Dispatch · PulsR</PageTitle>
<section class="dispatch-page dispatch-board">
    <PageHeader Title="Dispatch">
        <AuthorizeView Roles="Admin,Dispatch">
            <a class="btn btn--primary" href="/dispatch/new">New load</a>
        </AuthorizeView>
    </PageHeader>
    @* One row, as on Fleet Map: the search, the driver filter, the view and,
       at the row's end, the scope. On a phone the driver filter waits
       behind Filters; the view and the scope stay in reach. *@
    <div class="dispatch-page__filters dispatch-board__filters filter-toolbar">
        <SearchInput Id="dispatch-search" Placeholder="Truck, driver, trailer or load" Value="@_search"
                     Options="SearchOptions" Loading="@(_loadedSearch != _search)" Changed="OnSearchInput" Selected="ChooseSearchAsync" Enter="SubmitSearchAsync" />
        <button type="button" class="btn filter-toolbar__drawer-toggle"
                aria-expanded="@(_filtersOpen ? "true" : "false")"
                aria-controls="dispatch-filters"
                @onclick="() => _filtersOpen = !_filtersOpen">
            <ActionIcon Kind="filters" /><span>Filters</span>
        </button>
        <div id="dispatch-filters"
             class="filter-toolbar__drawer @(_filtersOpen ? "is-open" : "")">
            <DriverGroupPicker Id="dispatch-driver-group" />
            @if (TruckId.HasValue)
            { <a class="btn" href="/dispatch">Show all trucks</a> }
        </div>
        <div class="dispatch-view filter-toolbar__views" role="group" aria-label="Dispatch view">
            @* History has no live trucks to show as cards (the owner,
               September 27): in Completed the button stays, so the toolbar
               does not move, but is off. *@
            <button type="button" aria-pressed="@(ShownView == 0 ? "true" : "false")" disabled="@_showCompleted" title="@(_showCompleted ? "Completed loads read as the table or the papers" : null)" @onclick="() => SelectViewAsync(0)"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="2" /><path d="M3 8h14M7 8v9" /></svg>Cards</button>
            <button type="button" aria-pressed="@(ShownView == 1 ? "true" : "false")" @onclick="() => SelectViewAsync(1)"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="2" /><path d="M3 8h14M3 12h14M8 3v14" /></svg>Table</button>
            <button type="button" aria-pressed="@(ShownView == 2 ? "true" : "false")" @onclick="() => SelectViewAsync(2)"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2h7l4 4v12H5zM12 2v5h4M8 10h5M8 13h5" /></svg>Papers</button>
        </div>
        <div class="dispatch-board__scope filter-toolbar__views" role="group" aria-label="Load scope">
            <button id="dispatch-active" type="button" aria-pressed="@(!_showCompleted ? "true" : "false")" @onclick="() => SelectScopeAsync(false)">Active</button>
            <button id="dispatch-completed" type="button" aria-pressed="@(_showCompleted ? "true" : "false")" @onclick="() => SelectScopeAsync(true)">Completed</button>
        </div>
    </div>
    <div class="dispatch-board__body">
    @if (_error is not null)
    {
        <p class="dispatch-board__message dispatch-page__error" role="alert">@_error <button class="btn" @onclick="() => LoadAsync(_page)">Retry</button></p>
    }
    @if (_loading && _data is null) { <p class="dispatch-board__message" role="status"><LoadingIndicator /></p> }
    else if (_data is not null)
    {
        <div class="dispatch-board__count">@_data.TotalCount @(_showCompleted ? _data.TotalCount == 1 ? "completed load" : "completed loads" : _data.TotalCount == 1 ? "truck" : "trucks")<span>@CountNote</span></div>
        @if (_data.Items.Count == 0) { <div class="dispatch-board__empty">@(_showCompleted ? "No completed loads match this search." : "No trucks or upcoming loads match this search.")</div> }
        @if (ShownView == 1)
        {
            <DispatchTable Trucks="_data.Items" Completed="_showCompleted"
                LoadPhase="LoadPhase" Refreshing="RefreshingEstimates"
                ReturnOrigin="@ReturnOrigin" />
        }
        else if (ShownView == 2)
        {
            <DispatchPapers Trucks="_data.Items" Completed="_showCompleted"
                LoadPhase="LoadPhase" Refreshing="RefreshingEstimates"
                ReturnOrigin="@ReturnOrigin" />
        }
        else
        {
        @foreach (var truck in _data.Items)
        {
            var planningLoad = PlanningLoad(truck);
            <article class="dispatch-truck" @key="truck.Key" aria-label="@($"Truck {truck.TruckNumber}")">
                @if (!_showCompleted && truck.TruckId.HasValue)
                {
                    @* A truck without a load has no snapshot, so no forecast
                       reaches its ForecastChanged. *@
                    <DispatchPlanning @key="PlanningIdentity(truck)"
                        TruckId="truck.TruckId"
                        Load="planningLoad"
                        ShowPlanningLoad="@(planningLoad?.Id
                            != truck.Dispatches.FirstOrDefault()?.Id)"
                        Compact="true" BoardHeader="true" Hos="truck.Hos"
                        CurrentCycle="truck.CurrentCycle"
                        Refreshing="RefreshingEstimates"
                        Speed="truck.Speed" EngineState="@truck.EngineState"
                        Managed="true"
                        Snapshot="@(truck.Dispatches.Count > 0
                            ? _planningSummaries.GetValueOrDefault(
                                truck.TruckId.Value)
                            : null)"
                        ForecastChanged="forecast => OnForecastChanged(
                            truck, planningLoad!.Id, forecast)">
                        <Identity>@TruckIdentity(truck)</Identity>
                    </DispatchPlanning>
                }
                else
                {
                    <header class="dispatch-truck__header"
                        >@TruckIdentity(truck)</header>
                }
                <div class="dispatch-truck__loads" role="region" aria-label="@($"Loads for truck {truck.TruckNumber}")" tabindex="0">
                    @if (truck.Dispatches.Count == 0)
                    { <div class="dispatch-truck__available"><span aria-hidden="true">○</span><div><strong>No active dispatch</strong><p>Ready for the next assignment.</p></div></div> }
                    @{ var (passed, currentIndex) = LoadPosition(truck); }
                    @for (var index = 0; index < truck.Dispatches.Count; index++)
                    {
                        var load = truck.Dispatches[index];
                        var current = index == currentIndex;
                        var order = LoadOrder(index, passed, currentIndex);
                        var summary = CardPlanningSummary(truck, load);
                        <DispatchLoadCard @key="LoadIdentity(load)" Load="load"
                            Truck="truck" Current="current" Order="order"
                            StopsPassed="index < passed"
                            Refreshing="RefreshingEstimates"
                            ReturnOrigin="@ReturnOrigin"
                            StopChanged="() => StopChangedAsync(load)"
                            RemainingMiles="summary.RemainingMiles" FuelStopCount="summary.FuelStopCount" />
                    }
                    @if (truck.TruckId.HasValue && truck.Dispatches.Count == 1 && IsCurrent(truck.Dispatches[0]))
                    {
                        <div class="dispatch-truck__available dispatch-truck__available--next" role="note" aria-label="Next load">
                            <div><strong>No next load</strong><p>Nothing scheduled after this load.</p></div>
                        </div>
                    }
                </div>
            </article>
        }
        }
        <footer class="dispatch-board__footer">
        @if (_view == 1)
        { <p class="dispatch-board__rpm-note">Loaded RPM: rate ÷ loaded miles · Total RPM: rate ÷ (loaded + empty miles)</p> }
        @if (_data.TotalPages > 1 || (_view == 1 && _data.TotalCount > 0))
        {
            <nav class="dispatch-page__pagination" aria-label="@(_showCompleted ? "Completed load pages" : "Truck pages")">
                <button class="btn" disabled="@(!_data.HasPreviousPage)" @onclick="() => LoadAsync(_page - 1)">Previous</button>
                <span>Page @_data.Page of @_data.TotalPages</span>
                <button class="btn" disabled="@(!_data.HasNextPage)" @onclick="() => LoadAsync(_page + 1)">Next</button>
            </nav>
        }
        </footer>
    }
    </div>
</section>

@code {
    // The unit and, past a hairline, its trailer and driver, the way a
    // dispatcher says them; then the way to the truck on the map. The same
    // on Active, where it heads the truck's summary, and on Completed.
    private RenderFragment TruckIdentity(TruckDispatchBoardResponse truck) =>
        @<text>
            <div class="dispatch-truck__identity">
                <h2>@(string.IsNullOrWhiteSpace(truck.TruckNumber)
                    ? "Awaiting assignment" : truck.TruckNumber)</h2>
                @{
                    var trailer = !string.IsNullOrWhiteSpace(truck.TrailerNumber);
                    var driver = !_showCompleted
                        || !string.IsNullOrWhiteSpace(truck.DriverName);
                }
                @if (trailer || driver)
                {
                    <span class="dispatch-truck__crew">
                        @if (trailer)
                        {
                            <span class="dispatch-truck__trailer"
                                  title="Trailer">@truck.TrailerNumber</span>
                        }
                        @if (driver)
                        {
                            <span class="dispatch-truck__header-driver"
                                  title="Driver">@(string.IsNullOrWhiteSpace(
                                truck.DriverName)
                                ? "Driver not assigned"
                                : truck.DriverName)</span>
                        }
                    </span>
                }
            </div>
            @if (truck.TruckId.HasValue)
            {
                <a class="btn btn--small dispatch-truck__map"
                   href="@($"/fleet/map?truckId={truck.TruckId}")"
                   aria-label="@($"Show truck {truck.TruckNumber} on map")">
                    <ActionIcon Kind="location" /><span>Show on map</span>
                </a>
            }
        </text>;
}
