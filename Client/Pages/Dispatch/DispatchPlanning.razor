@if (BoardHeader)
{
    <section class="dispatch-planning dispatch-planning--board"
             aria-label="Truck summary">
        <header class="dispatch-truck__header">
            @Identity
            @if (LeftMiles is { } left)
            {
                <span class="dispatch-planning__left"
                      aria-label="@(Units.FormatDistance(left)
                          + " left to the next stop")">
                    <span aria-hidden="true">Left&#160;<strong
                        >@Units.DistanceValue(left)</strong><span
                        >&#160;@Units.DistanceUnit</span>@if (Units.BothDistances)
                        {<small> ·&#160;@Units.Kilometers(left)&#160;km</small>}</span>
                </span>
            }
        </header>
        <div class="dispatch-planning__readings">
            <TruckReadings Speed="Speed"
                           Fuel="@DisplayResult?.State?.FuelPercent"
                           Engine="@EngineState" />
            @* The driver's clocks, named by their labels alone; the group
               keeps "HOS" as its name for a screen reader. *@
            <span class="dispatch-planning__clocks" aria-label="HOS">
                <DriverHours Clocks="Hos" Dials="false" ShowDutyStatus="false"
                             Jurisdiction="@DutyStatus?.Jurisdiction" />
            </span>
        </div>
        @if (_loading && _result is null)
        {
            <p class="dispatch-planning__hint" role="status"
                ><LoadingIndicator /></p>
        }
        @if (ShowRefreshError)
        {
            <p class="dispatch-planning__hint" role="status"
                >@RouteMessageDisplay.Concise(_error)</p>
        }
        @if (DisplayMessage is { } boardMessage)
        { <p class="dispatch-planning__hint" role="status">@boardMessage</p> }
        @if (DisplayResult?.State is { Plan: { } boardPlan } boardState)
        {
            @foreach (var warning in boardPlan.Route.Warnings)
            {
                <p class="dispatch-planning__hint" role="status"
                    >@RouteMessageDisplay.Concise(warning)</p>
            }
            @if (boardState.Progress?.OffRoute == true)
            {
                <p class="dispatch-planning__hint" role="status"
                    >Off planned route</p>
            }
        }
        <div class="dispatch-planning__duty">
            <DriverDutySummary Reading="row" Status="DutyStatus"
                               CurrentStatus="@(Hos?.CurrentDutyStatus)"
                               ClockUpdatedAt="Hos?.UpdatedAt" />
            <DriverNextRecap Snapshot="CurrentCycle" />
        </div>
    </section>
}
else
{
<section class="dispatch-planning @(Compact ? "dispatch-planning--compact" : "")" aria-label="Route">
    <div class="dispatch-planning__content">
    <div class="dispatch-planning__heading">
        <div class="dispatch-planning__identity"><strong>Route</strong>
            @if (DisplayResult?.LoadNumber is { } number && Compact) { <span>Load <LoadNumber Value="number" /></span> }
        </div>
        <div class="dispatch-planning__telemetry">
            @if (DisplayResult?.State?.FuelPercent is { } percent) { <span class="dispatch-planning__fuel"><FuelReading Percent="percent" /></span> }
        </div>
    </div>
    @if (_loading && _result is null) { <p role="status"><LoadingIndicator /></p> }
    @if (ShowRefreshError) { <p class="dispatch-planning__hint" role="status">@RouteMessageDisplay.Concise(_error)</p> }
    @if (DisplayMessage is { } message) { <p class="dispatch-planning__hint" role="status">@message</p> }
    @if (DisplayResult?.State is { Plan: { } plan } state)
    {
        @foreach (var warning in plan.Route.Warnings)
        { <p class="dispatch-planning__hint" role="status">@RouteMessageDisplay.Concise(warning)</p> }
        <div class="dispatch-planning__metrics" role="group" aria-label="Route distances">
            <div class="dispatch-planning__metric"><span>Total Distance</span><strong><span class="dispatch-planning__miles">@Units.DistanceValue(plan.OriginalPlannedMiles) @Units.DistanceUnit</span>@if (Units.BothDistances) { <br /><small>@Units.Kilometers(plan.OriginalPlannedMiles) km</small> }</strong></div>
            <div class="dispatch-planning__metric"><span>Remaining</span><strong><span class="dispatch-planning__miles">@Units.DistanceValue(state.Progress?.RemainingMiles) @Units.DistanceUnit</span>@if (Units.BothDistances) { <br /><small>@Units.Kilometers(state.Progress?.RemainingMiles) km</small> }</strong></div>
            <div class="dispatch-planning__metric dispatch-planning__next-distance"><span>Next Stop</span><strong><span class="dispatch-planning__miles">@Units.DistanceValue(plan.RemainingToNextStop(state.Progress?.ProgressMiles)) @Units.DistanceUnit</span>@if (Units.BothDistances) { <br /><small>@Units.Kilometers(plan.RemainingToNextStop(state.Progress?.ProgressMiles)) km</small> }</strong></div>
            @if (state.Progress?.OffRoute == true) { <span class="dispatch-planning__hint">Off planned route</span> }
        </div>
        @if (!Compact)
        {
            <div class="dispatch-planning__details">
                @if (plan.Tracking.NextStopId.HasValue)
                {
                    <div class="dispatch-planning__next">
                        <span>Next stop</span>
                        <strong>@plan.Tracking.NextStopLabel</strong>
                    </div>
                }
                <ArrivalEstimate Eta="_result?.State?.Eta" ShowDutyStatus="true" Stop="ArrivalStop" Memory="_arrivalMemory"
                    DispatchId="_result?.DispatchId" Completed="ArrivalCompleted" Refreshing="RefreshingEstimate" />
            </div>
        }
    }
    </div>
    @if (Compact)
    {
        <div class="dispatch-planning__driver">
            <DriverDutySummary Status="DutyStatus" CurrentStatus="@(Hos?.CurrentDutyStatus)" ClockUpdatedAt="Hos?.UpdatedAt" />
            <DriverNextRecap Snapshot="CurrentCycle" />
        </div>
        <DriverHours Clocks="Hos" ShowDutyStatus="false"
                     Status="DutyStatus" />
    }
</section>
}
