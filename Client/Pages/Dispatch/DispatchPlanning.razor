
<section class="dispatch-planning @(Compact ? "dispatch-planning--compact" : "") @(BoardHeader ? "dispatch-planning--board" : "")" aria-label="Route">
    <div class="dispatch-planning__content">
    <div class="dispatch-planning__heading">
        <div class="dispatch-planning__identity"><strong>Route</strong>
            @if (DisplayResult?.LoadNumber is { } number && Compact) { <span>Load <LoadNumber Value="number" /></span> }
        </div>
        <div class="dispatch-planning__telemetry">
            @if (BoardHeader && !string.IsNullOrWhiteSpace(MotionLabel))
            { <span class="dispatch-truck__status is-@MotionState @TelemetryTone.Speed(Speed)"><span aria-hidden="true">●</span>@MotionLabel</span> }
            @if (DisplayResult?.State?.FuelPercent is { } percent) { <span class="dispatch-planning__fuel"><FuelReading Percent="percent" /></span> }
        </div>
    </div>
    @if (_loading && _result is null) { <p role="status">Loading saved route…</p> }
    @if (ShowRefreshError) { <p class="dispatch-planning__hint" role="status">@RouteMessageDisplay.Concise(_error)</p> }
    @if (DisplayMessage is { } message) { <p class="dispatch-planning__hint" role="status">@message</p> }
    @if (DisplayResult?.State is { Plan: { } plan } state)
    {
        @foreach (var warning in plan.Route.Warnings)
        { <p class="dispatch-planning__hint" role="status">@RouteMessageDisplay.Concise(warning)</p> }
        <div class="dispatch-planning__metrics" role="group" aria-label="Route distances">
            <div class="dispatch-planning__metric"><span>Total Distance</span><strong><span class="dispatch-planning__miles">@plan.OriginalPlannedMiles.ToString("N0") mi</span><br /><small>@((plan.OriginalPlannedMiles * 1.609344).ToString("N0")) km</small></strong></div>
            <div class="dispatch-planning__metric"><span>Remaining</span><strong><span class="dispatch-planning__miles">@(state.Progress?.RemainingMiles?.ToString("N0") ?? "—") mi</span><br /><small>@((state.Progress?.RemainingMiles * 1.609344)?.ToString("N0") ?? "—") km</small></strong></div>
            <div class="dispatch-planning__metric dispatch-planning__next-distance"><span>Next Stop</span><strong><span class="dispatch-planning__miles">@(plan.RemainingToNextStop(state.Progress?.ProgressMiles)?.ToString("N0") ?? "—") mi</span><br /><small>@((plan.RemainingToNextStop(state.Progress?.ProgressMiles) * 1.609344)?.ToString("N0") ?? "—") km</small></strong></div>
            @if (state.Progress?.OffRoute == true) { <span class="dispatch-planning__hint">Off planned route</span> }
        </div>
        @if (!Compact)
        {
            <div class="dispatch-planning__details">
                @if (plan.Tracking.NextStopId.HasValue)
                {
                    <div class="dispatch-planning__next">
                        <span>Next stop</span>
                        <strong>@plan.Tracking.NextStopLabel</strong>
                    </div>
                }
                <ArrivalEstimate Eta="_result?.State?.Eta" ShowDutyStatus="true" Stop="ArrivalStop" Memory="_arrivalMemory"
                    DispatchId="_result?.DispatchId" Completed="ArrivalCompleted" Refreshing="RefreshingEstimate" />
            </div>
        }
    }
    </div>
    @if (Compact)
    {
        <div class="dispatch-planning__driver">
            <DriverDutySummary Status="DisplayResult?.State?.Eta?.DutyStatus" CurrentStatus="@(Hos?.CurrentDutyStatus)" ClockUpdatedAt="Hos?.UpdatedAt" Compact="BoardHeader" />
            <DriverNextRecap Snapshot="CurrentCycle" />
        </div>
        <DriverHours Clocks="Hos" ShowDutyStatus="false" />
    }
</section>
