@page "/fleet/map"
@using Client.Services

<PageTitle>Fleet Map · PulsR</PageTitle>

<div class="fleet-map-page">
    <div class="fleet-map-page__background">
    <div class="fleet-map-title">
        <h1>Fleet Map</h1>
        <p>Live positions · trips · fuel</p>
    </div>

    <fieldset class="fleet-map-toolbar filter-toolbar"
              disabled="@(_disposed || !_preferencesLoaded || _initializing)">
        <legend class="visually-hidden">Map filters</legend>
        <div class="fleet-map-search">
            <SearchInput Id="fleet-truck-search" Placeholder="Truck, driver or trailer" Value="@TruckSearch"
                         Options="SearchOptions" Changed="OnTruckSearchChanged" Selected="ChooseSearchTruckAsync" Enter="SearchEnterAsync" />
            @if (!string.IsNullOrWhiteSpace(TruckSearch))
            { <span class="visually-hidden" role="status">@MatchingTrucks.Count found</span> }
        </div>
        <button type="button"
                class="btn fleet-map-mobile-filters filter-toolbar__drawer-toggle"
                aria-expanded="@(_mobileFiltersOpen ? "true" : "false")" aria-controls="fleet-map-filters" @onclick="() => _mobileFiltersOpen = !_mobileFiltersOpen">
            <ActionIcon Kind="filters" /><span>Filters</span>
        </button>
        <div id="fleet-map-filters"
             class="fleet-map-filters filter-toolbar__drawer @(_mobileFiltersOpen
                 ? "is-open" : "")">
        @* The driver filter is a filter: on a phone it waits behind the
           Filters button with the layers (the owner, September 26), and
           on a wide toolbar the group is transparent, so it stands where
           it did. *@
        <DriverGroupPicker Id="fleet-map-driver-group" />
        <div class="fleet-map-layer-controls"
             aria-busy="@(!_preferencesLoaded ? "true" : "false")"
             aria-hidden="@(!_preferencesLoaded ? "true" : "false")">
        @* Each layer is a chip that says its name and, where the map draws
           it in one colour, shows that colour: the stations' green and the
           next loads' violet. Bare icons read as nothing (September 26). *@
        <div class="fleet-map-layers" role="group" aria-label="Map layers">
        <label class="fleet-map-toggle filter-toolbar__toggle"
               title="Fuel Stations">
            <input
                type="checkbox" class="visually-hidden"
                aria-label="Fuel Stations"
                @bind="ShowFuelStations"
                @bind:after="OnFuelStationsToggleChanged" />
            <span class="fleet-map-toggle__swatch fleet-map-toggle__swatch--stations"
                  aria-hidden="true"></span><span>Fuel Stations</span>
        </label>

        <label class="fleet-map-toggle filter-toolbar__toggle"
               title="Traffic">
            <input
                type="checkbox" class="visually-hidden"
                aria-label="Traffic"
                @bind="ShowTraffic"
                @bind:after="OnTrafficToggleChanged" />

            <ActionIcon Kind="traffic" /><span>Traffic</span>
        </label>
        <label class="fleet-map-toggle filter-toolbar__toggle"
               title="Next loads">
            <input type="checkbox" class="visually-hidden"
                   aria-label="Next loads" @bind="ShowNextLoads"
                   @bind:after="OnNextLoadsChanged" />
            <span class="fleet-map-toggle__swatch fleet-map-toggle__swatch--next"
                  aria-hidden="true"></span><span>Next loads</span>
        </label>
        </div>
        </div>
        @* Said to a screen reader only: on screen it covered the head
           (the owner, September 27); the next poll reads the routes again. *@
        @if (ShowNextLoads && _nextLoadsMessage is not null)
        {
            <span class="visually-hidden" role="status">@_nextLoadsMessage</span>
        }
        </div>
    </fieldset>
    @* Which trucks the list shows, by what they are doing now: the same
       motion the map draws as an arrow or a circle. *@
    <div class="fleet-map-motion" role="group" aria-label="Trucks in the list">
        @foreach (var (motion, label) in MotionChoices)
        {
            <button type="button"
                    class="fleet-map-motion__chip fleet-map-motion__chip--@motion"
                    aria-pressed="@(_motion == motion ? "true" : "false")"
                    @onclick="() => ChooseMotionAsync(motion)">
                @if (motion != "all")
                {
                    <span class="fleet-map-motion__dot" aria-hidden="true"></span>
                }
                <span>@label</span>
                <span class="fleet-map-motion__count">@MotionCount(motion)</span>
            </button>
        }
    </div>
    @if (MapError is not null)
    {
        <p class="fleet-map-page__message" role="alert">
            @MapError
            <button class="btn btn--small" disabled="@_initializing" @onclick="StartMapAsync">Retry</button>
        </p>
    }
    @if (FocusError is not null) { <p class="fleet-map-page__message" role="status">@FocusError</p> }
    @if (TruckError is not null)
    {
        <p class="fleet-map-page__message" role="status">@TruckError</p>
    }
    @if (StationError is not null)
    {
        <p class="fleet-map-page__message" role="alert">@StationError <button class="btn btn--small" @onclick="OnDateChanged">Retry</button></p>
    }
    </div>
    <div class="fleet-map-stage">
    <FleetTruckList Trucks="ListedTrucks" Total="_trucks.Count"
                    SelectedId="_activeTruckId"
                    Selected="ChooseListTruckAsync"
                    @bind-Collapsed="_listCollapsed" />
    <div
        id="fleet-map"
        @ref="_mapElement"
        tabindex="-1"
        aria-label="Fleet and fuel station map"
        aria-busy="@_initializing">
    </div>
    @* One compact bar over the map: the chosen truck's actions (Follow,
       Fit route, Camera, Route options, Fuel), then the layers. Zoom and
       panning are the map's own gestures. *@
    @* A press anywhere outside the open Layers menu closes it. *@
    @if (_layersOpen)
    {
        <div class="fleet-map-layer-dismiss" aria-hidden="true"
             @onclick="() => _layersOpen = false"></div>
    }
    <div class="fleet-map-controls" role="toolbar" aria-label="Map tools">
        @* The truck's actions are always in the bar; with no truck chosen
           they are shown disabled, so the bar keeps its shape. *@
        <div class="fleet-map-inspector__actions" role="group"
             aria-label="Truck actions">
            <button type="button"
                    class="btn map-action-icon fleet-map-inspector__follow
                        @(_followingTruck ? "btn--primary" : "")"
                    title="@(_followingTruck ? "Following - press to stop" : "Follow")"
                    aria-label="Follow"
                    aria-pressed="@(_followingTruck ? "true" : "false")"
                    disabled="@(SelectedTruck is null)"
                    @onclick="ToggleFollowAsync">
                <ActionIcon Kind="follow" /><span>@(_followingTruck ? "Following" : "Follow")</span>
            </button>
            <button type="button" class="btn map-action-icon"
                    title="Show route" aria-label="Show route"
                    disabled="@(SelectedTruck is null || !CanShowRoute)"
                    @onclick="ShowRouteAsync">
                <ActionIcon Kind="fit" /><span>Fit route</span>
            </button>
            <button type="button" class="btn map-action-icon"
                    title="Camera" aria-label="Camera"
                    disabled="@(SelectedTruck is null)"
                    @onclick="OpenCameraAsync">
                <ActionIcon Kind="camera" /><span>Camera</span>
            </button>
            <button type="button" class="btn map-action-icon"
                    title="Route options" aria-label="Route options"
                    disabled="@(SelectedTruck is null || _fuelEditorOpen
                        || SelectedDispatchId is null)"
                    @onclick="OpenSelectedRouteEditorAsync">
                <ActionIcon Kind="route" /><span>Route options</span>
            </button>
            <button type="button" class="btn map-action-icon"
                    title="Fuel plan" aria-label="Fuel"
                    disabled="@(SelectedTruck is null || _fuelEditorOpen
                        || _sendPlanOpen)"
                    @onclick="OpenFuelPlanAsync">
                <ActionIcon Kind="fuel" /><span>Fuel</span>
            </button>
        </div>
        @* The layers, behind the map's own button as the concept keeps them;
           the same switches as the phone's Filters drawer. *@
        <div class="fleet-map-controls__layers">
            <button type="button"
                    class="fleet-map-controls__button fleet-map-controls__button--layers"
                    title="Map layers" aria-label="Map layers"
                    aria-expanded="@(_layersOpen ? "true" : "false")"
                    aria-controls="fleet-map-layer-menu"
                    @onclick="() => _layersOpen = !_layersOpen">
                <ActionIcon Kind="layers" />
            </button>
            @if (_layersOpen)
            {
                <fieldset id="fleet-map-layer-menu" class="fleet-map-layer-menu"
                          disabled="@(_disposed || !_preferencesLoaded || _initializing)">
                    <legend class="visually-hidden">Map layers</legend>
                    <label><input type="checkbox" @bind="ShowFuelStations"
                        @bind:after="OnFuelStationsToggleChanged" />
                        <span>Fuel stations</span></label>
                    <label><input type="checkbox" @bind="ShowTraffic"
                        @bind:after="OnTrafficToggleChanged" />
                        <span>Traffic</span></label>
                    <label><input type="checkbox" @bind="ShowNextLoads"
                        @bind:after="OnNextLoadsChanged" />
                        <span>Next loads</span></label>
                </fieldset>
            }
        </div>
    </div>
    <section class="fleet-map-info-reserved fleet-map-inspector
                    @(InspectorVisible ? "has-selection" : "")
                    @(MapOverlayOpen ? "is-overlaid" : "")"
             aria-label="Map information"
             inert="@MapOverlayOpen"
             data-inspector-mode="@_inspectorMode.ToString().ToLowerInvariant()"
             @onkeydown="OnInspectorKeyDownAsync"
             @onkeydown:stopPropagation="true">
        @if (!InspectorVisible)
        {
            @* Docked, the panel keeps its place with nothing chosen, so the
               map and the chain never move; it says so and shows nothing
               of the truck that was. *@
            <div class="fleet-map-inspector__empty" role="status">
                <strong>No truck selected</strong>
                <span>Choose a truck on the map or in the list.</span>
            </div>
        }
        <header class="fleet-map-inspector__header">
        @if (_inspectorMode == MapInspectorMode.Truck)
        {
            @* The unit names the card, under its emblem. *@
            <div class="fleet-map-inspector__identity">
                <span class="fleet-map-inspector__eyebrow" aria-hidden="true">Truck</span>
                <strong class="fleet-map-inspector__title fleet-map-inspector__desktop-title">@(SelectedTruck is { } named ? named.UnitNumber : InspectorTitle)</strong>
            </div>
        }
        else
        {
            @* Every card's head reads the same way (the owner, September
               28): what the card is about under the truck it belongs to,
               and Back in one fixed place beside the close. *@
            <div class="fleet-map-inspector__identity">
                <span class="fleet-map-inspector__eyebrow"
                    >@(SelectedTruck is { } owner
                        ? $"Truck {owner.UnitNumber}" : "\u00a0")</span>
                <strong class="fleet-map-inspector__title"
                    >@InspectorTitle</strong>
            </div>
            @* The truck's fuel closes back to the truck; it has no Back. *@
            @if (HasTruckInspection
                && _inspectorMode is not (MapInspectorMode.FuelPlan
                    or MapInspectorMode.FuelStations))
            {
                <button type="button"
                        class="btn btn--small fleet-map-inspector__back"
                        @onclick="BackToTruckAsync">
                    <span aria-hidden="true">←</span>
                    @(_fuelReturn switch
                    {
                        MapInspectorMode.FuelPlan => "Back to plan",
                        MapInspectorMode.FuelStations => "Back to stations",
                        _ => "Back to truck",
                    })
                </button>
            }
        }
        @* The close control belongs to every card. A stop opened from the
           map used to offer only "Back to truck", which is a different
           thing: it goes somewhere, and closing leaves the map clear. *@
        <div class="fleet-map-inspector__controls">
            @if (_inspectorMode is MapInspectorMode.FuelPlan
                or MapInspectorMode.FuelStations)
            {
                <button type="button"
                        class="btn btn--small fleet-map-inspector__close"
                        aria-label="@("Close "
                            + InspectorTitle.ToLowerInvariant())"
                        @onclick="BackToTruckAsync">×</button>
            }
            else
            {
                <button type="button"
                        class="btn btn--small fleet-map-inspector__close"
                        aria-label="Close map information"
                        @onclick="CloseInspectorAsync">×</button>
            }
        </div>
        </header>
        @if (SelectedTruck is { } panelTruck)
        {
            @* The truck as the workspace concept draws it: the next stop,
               eight facts in bordered cells and the driver's clocks. Its
               actions are in the map's bar; its trips are the chain's cards.
               Kept mounted while a truck is selected and parked in the other
               views, so the truck's readings (the weather) are not fetched
               again on the way back. Parked, not hidden: display: none
               would replay its arrival on the way back; inert keeps it out
               of focus and the accessibility tree. *@
            <div class="fleet-truck-panel
                        @(_inspectorMode != MapInspectorMode.Truck ? "is-parked" : "")"
                 inert="@(_inspectorMode != MapInspectorMode.Truck)">
            @* The truck's current load (the owner, September 28): its
               number opens the load, its order number copies. Only the
               work the planning owner names current, never a first or
               later load of the truck. *@
            @if (CurrentLoad is { } current)
            {
                <div class="fleet-truck-load" aria-label="Current load"
                     @key="(3, current.Id)">
                    <span class="fleet-truck-load__pair">
                        <span class="fleet-truck-load__term">Load</span>
                        <a class="fleet-truck-load__link" title="Open load"
                           href="@ReturnNavigation.Load(current.Id,
                               ReturnOrigin)"
                           ><strong><Client.Shared.Dispatch.LoadNumber.LoadNumber
                               Value="current.LoadNumber" /></strong><ActionIcon
                               Kind="external-link" /></a>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(current.OrderNumber))
                    {
                        <span class="fleet-truck-load__pair">
                            <span class="fleet-truck-load__term">Order</span>
                            <span class="fleet-truck-load__order"
                                ><CopyValue Value="@current.OrderNumber"
                                    Scope="(_activeTruckId, current.Id)"
                                    Class="fleet-truck-load__copy"
                                    StatusClass="fleet-truck-load__copied"
                                    Title="Copy order number"
                                    >@current.OrderNumber</CopyValue></span>
                        </span>
                    }
                </div>
            }
            @* Where the truck is going next, when it gets there and how
               far it still has to drive (the owner, September 27): the
               route's own forecast and distance, read here too. *@
            @if (ScheduledStop is { } upcoming)
            {
                @* Keyed by the stop, so a new stop arrives as new
                   information and a poll of the same stop plays nothing. *@
                <section class="fleet-truck-next" aria-label="Next stop"
                         @key="(0, upcoming.Id)">
                    <div class="fleet-truck-next__head">
                        <span class="fleet-truck-next__label">Next stop</span>
                        <span class="fleet-truck-next__left"
                              title="Distance to the next stop">
                            <strong>@Units.DistanceValue(_routeState?.Plan is null
                                ? null : LeftMiles)</strong>
                            <small>@Units.DistanceUnit@(Units.BothDistances
                                ? $" · {Units.Kilometers(_routeState?.Plan is null ? null : LeftMiles)} km"
                                : "") left</small>
                        </span>
                    </div>
                    <div class="fleet-truck-next__place">
                        @FleetAppointmentDisplay.Visit(upcoming)@(string.IsNullOrWhiteSpace(upcoming.Name)
                            ? "" : $" · {upcoming.Name.Trim()}")
                        @if (!string.IsNullOrWhiteSpace(upcoming.Address))
                        {
                            <span>@Client.Services.StopAddressLines.Create(upcoming.Address).Locality</span>
                        }
                    </div>
                    <div class="fleet-truck-next__eta arrival-estimate">
                        @* The booking of the stop the forecast is for, in the
                           stop's own time zone; a window ending another day
                           is two lines. The visit is named on the place line
                           above, so the row says Appointment and its hours
                           stand in the ETA's column (the owner, Sept 27). *@
                        @if (HeadAppointmentStop is { } booked)
                        {
                            <span class="arrival-estimate__appointment fleet-truck-next__booking"><span
                                class="fleet-truck-next__term">Appointment</span>
                                <CopyValue Value="@HeadAppointmentText(booked)"
                                    Scope="(_activeTruckId, booked.Id)"
                                    Class="fleet-truck-next__copy"
                                    StatusClass="fleet-truck-next__copied"
                                    Title="@($"Copy appointment: {HeadAppointmentText(booked)}")"
                                    ><strong class="fleet-truck-next__hours">
                                    @foreach (var line in HeadAppointmentLines(booked))
                                    {
                                        <span>@line</span>
                                    }
                                </strong></CopyValue>
                            </span>
                        }
                        <ArrivalEstimate
                            Eta="@(_routeState?.Plan is { InputsChanged: false }
                                ? DisplayRouteState?.Eta : null)"
                            Stop="ScheduledStop" Memory="_arrivalMemory"
                            DispatchId="SelectedDispatchId"
                            Refreshing="_etaRefreshPending"
                            Completed="@(_routeState?.Plan?.Tracking
                                .AllStopsPassed == true)"
                            ShowDutyStatus="false" ShowAppointment="false"
                            ShowDetails="false" Reading="compact" />
                    </div>
                </section>
            }
            @* The facts and the clocks are keyed by the truck: choosing
               another truck brings them in anew. *@
            <dl class="fleet-truck-facts" aria-label="Truck facts"
                @key="(1, panelTruck.TruckId)">
                <div class="fleet-truck-facts__fact">
                    <ActionIcon Kind="user" />
                    <div><dt>Driver</dt><dd>@(string.IsNullOrWhiteSpace(
                        HosDriverName(panelTruck)) ? "—"
                        : HosDriverName(panelTruck))</dd></div>
                </div>
                <div class="fleet-truck-facts__fact">
                    <ActionIcon Kind="trailer" />
                    <div><dt>Trailer</dt><dd title="@TrailerTitle(panelTruck)"
                        >@(TrailerDiscrepancy(panelTruck) is { } conflict
                            ? conflict.Text
                            : string.IsNullOrWhiteSpace(panelTruck.TrailerNumber)
                                ? "—" : panelTruck.TrailerNumber)</dd></div>
                </div>
                <div class="fleet-truck-facts__fact">
                    <ActionIcon Kind="gauge" />
                    <div><dt>Motion</dt><dd>@MotionFact(panelTruck)</dd></div>
                </div>
                <div class="fleet-truck-facts__fact">
                    <ActionIcon Kind="clock" />
                    <div><dt>Duty</dt><dd>@DutyFact</dd>@if (DutySince is { } dutySince)
                        {<span class="fleet-truck-facts__detail">@dutySince</span>}</div>
                </div>
                <div class="fleet-truck-facts__fact">
                    <ActionIcon Kind="fuel" />
                    <div><dt>Fuel</dt><dd>@(panelTruck.FuelPercent is { } fuel
                        ? $"{fuel:0}%" : "—")</dd></div>
                </div>
                <div class="fleet-truck-facts__fact">
                    <ActionIcon Kind="engine" />
                    <div><dt>Engine</dt><dd>@(string.IsNullOrWhiteSpace(
                        panelTruck.EngineState) ? "—"
                        : panelTruck.EngineState)</dd></div>
                </div>
                @* The outside temperature, read by the weather owner. *@
                <Client.Shared.Trucks.TruckWeather.TruckWeather
                    Variant="fact" TruckId="panelTruck.TruckId"
                    Visibility="_visibility"
                    OwnerCancellation="_lifetime.Token"
                    Current="@(SelectedDate == DateOnly.FromDateTime(
                        DateTime.Today))" />
                <div class="fleet-truck-facts__fact fleet-truck-facts__fact--location">
                    <ActionIcon Kind="location" />
                    <div>
                        <dt>Location</dt>
                        @if (string.IsNullOrWhiteSpace(panelTruck.FormattedLocation))
                        {
                            <dd>@LocationSummary(panelTruck.FormattedLocation)</dd>
                        }
                        else
                        {
                            @* The text itself copies the full address. *@
                            <dd><CopyValue Value="@panelTruck.FormattedLocation"
                                Scope="panelTruck.TruckId"
                                Class="fleet-truck-facts__copy"
                                StatusClass="fleet-truck-facts__copied"
                                Title="@($"Copy location: {panelTruck.FormattedLocation}")"
                                >@LocationSummary(panelTruck.FormattedLocation)</CopyValue></dd>
                        }
                    </div>
                </div>
            </dl>
            <div class="fleet-truck-clocks" @key="(2, panelTruck.TruckId)">
                <DriverHours @key="_activeTruckId" Clocks="_hos"
                    Jurisdiction="@HeadDutyStatus?.Jurisdiction"
                    Dials="false" Bars="true" ShowDutyStatus="false" />
            </div>
            @if (RestRows.Count > 0)
            {
                @* The rest, in its own labelled rows (the owner, September
                   28): never a paragraph under the duty status. *@
                <dl class="fleet-truck-rest" aria-label="Rest">
                    @foreach (var (label, value) in RestRows)
                    {
                        <div><dt>@label</dt><dd>@value</dd></div>
                    }
                </dl>
            }
            </div>
        }
        <div class="fleet-map-inspector__native" hidden="@(_inspectorMode is not (MapInspectorMode.Stop or MapInspectorMode.Fuel))"></div>
        @if (_inspectorMode == MapInspectorMode.FuelPlan
            && SelectedTruck is { } fuelTruck)
        {
            <div class="fleet-map-inspector__body">
                <FleetFuelPlan
                    Plan="@CurrentFuelPlan"
                    Stale="@FuelPlanStale"
                    Updating="@_recalculatingFuel"
                    UpdateFailed="@_fuelUpdateFailed"
                    Unusable="@(_routeState?.Plan?.FuelPlan is not null)"
                    CurrentPercent="@((double?)fuelTruck.FuelPercent)"
                    TankGallons="@_routeState?.Profile.TankGallons"
                    CanEdit="@(CanEditFuel && !_fuelEditorOpen
                        && !_sendPlanOpen && !_recalculatingFuel)"
                    CanSend="CanSendPlan"
                    ViewStation="OpenPlannedStationAsync"
                    Edit="OpenFuelEditorAsync"
                    Send="OpenSendPlanAsync"
                    Stops="@(_routeState?.Plan?.Stops ?? [])"
                    NextStopId="@_routeState?.Plan?.Tracking.NextStopId"
                    OnlyDispatch="@(ShowNextLoads ? null : SelectedDispatchId)"
                    Stations="OpenFuelStationsAsync" />
            </div>
        }
        @if (_inspectorMode == MapInspectorMode.FuelStations)
        {
            <div class="fleet-map-inspector__body">
                <FleetFuelStations
                    Stations="_stations?.Stations"
                    Error="@StationError"
                    Date="SelectedDate" UseIfta="UseIfta"
                    Plan="@(Usable(_routeState?.Plan?.FuelPlan)
                        ? _routeState!.Plan!.FuelPlan : null)"
                    View="OpenListedStationAsync"
                    Back="BackToFuelPlanAsync" />
            </div>
        }
        @if (HasTruckInspection)
        {
            <div id="fleet-map-details" class="fleet-map-info-content" hidden="@(_inspectorMode != MapInspectorMode.Truck)">
    <div id="fleet-map-route-details" class="fleet-map-route-details">
    @if (!NothingToDrive && (_routeLoading || _loadDetails is not null || ScheduledStop is not null || _routeState?.Plan is not null))
    {
        var routePlan = _routeState?.Plan is { InputsChanged: false } availablePlan ? availablePlan : null;
        <div class="fleet-map-route-info @(routePlan is null ? "is-awaiting-route" : "") @(NextStopIsFinal ? "has-final-stop" : "")" aria-label="Current dispatch route" aria-busy="@(_routeLoading ? "true" : "false")">
            <div class="fleet-map-route-info__messages">
                @foreach (var conflict in _planningConflicts)
                { <span class="fleet-map-route-info__error" role="status">Load @conflict.LoadNumber: @Client.Shared.Dispatch.DispatchWorkPhase.ConflictText(conflict.Conflict)</span> }
                @foreach (var warning in routePlan?.Route.Warnings ?? [])
                { <span class="fleet-map-route-info__error" role="status">@Client.Shared.RouteMessageDisplay.Concise(warning)</span> }
                @if (routePlan is not null && (_routeState?.Progress?.OffRoute == true || _routeState?.Progress?.LocationStale == true))
                {
                    <div class="fleet-map-route-info__status" role="status">
                        @if (_routeState?.Progress?.OffRoute == true) { <span>Off planned route</span> }
                        @if (_routeState?.Progress?.LocationStale == true) { <span>GPS unavailable or stale</span> }
                    </div>
                }
                @if (VisibleRouteError is { } plannedRouteError)
                { <span class="fleet-map-route-info__error" role="status">@plannedRouteError</span> }
            </div>

        </div>
    }
    @if (NothingToDrive && VisibleRouteError is { } emptyRouteError) { <p class="fleet-map-route-info__error" role="status">@emptyRouteError</p> }
    </div>

            </div>
        }
        @if (_inspectorMode == MapInspectorMode.NextStop && InspectedRoute is { } inspected)
        {
            <button class="btn btn--text btn--small"
                @onclick="() => OpenRouteEditorAsync(inspected.Id,
                    inspected.ExecutionLegId)">
                Route options · <LoadNumber Value="inspected.LoadNumber" />
            </button>
            <NextLoadDetailsCard Embedded="true" Route="inspected" Stop="InspectedStop" StopIndex="_inspectedStopIndex"
                Marker="@InspectedStopMarker"
                FuelArrival="InspectedFuelArrival"
                DistanceMiles="InspectedDistanceMiles"
                Details="_inspectedDetails" Eta="InspectedEta" Refreshing="InspectedEtaRefreshing" Loading="@(_inspectedDetailsRequest is not null)"
                Error="@_inspectedDetailsError" CopyMessage="@_addressCopyMessage"
                OnCopy="CopyTextAsync" OnClose="BackToTruckAsync"
                ReturnOrigin="@ReturnOrigin" />
        }
    </section>

    @if (SelectedTruck is { } cameraTruck)
    {
        <TruckCamera @ref="_truckCamera" @key="cameraTruck.TruckId" TruckId="cameraTruck.TruckId"
            TruckNumber="@cameraTruck.UnitNumber" ShowTrigger="false" OpenChanged="OnCameraOpenChangedAsync" />
    }

    @* The map carries no key (the owner, September 27); only the
       attribution Google asks for while its weather is shown. *@
    @if (!_fuelEditorOpen && SelectedTruck is not null
        && SelectedDate == DateOnly.FromDateTime(DateTime.Today))
    {
        <small class="fleet-map-weather-source">
            Source: Includes weather data from Google
        </small>
    }
    @if (_fuelEditorOpen && _fuelEditorIdentity is { } editorIdentity)
    {
        <FuelPlanEditor @key="editorIdentity" TruckId="editorIdentity.Truck" DispatchId="editorIdentity.Dispatch"
            ExecutionLegId="editorIdentity.Leg"
            AssignmentRevision="editorIdentity.Revision"
            InitialCalculatedAt="_routeState?.Plan?.FuelPlan?.CalculatedAt"
            TruckNumber="@(SelectedTruck?.UnitNumber ?? "")" Station="_fuelEditorStation"
            StationSelected="@(station => OnFuelEditorStationSelectedAsync(editorIdentity, station))"
            BusyChanged="@(busy => OnFuelEditorBusyChangedAsync(editorIdentity, busy))"
            Failed="@(() => OnFuelEditorFailedAsync(editorIdentity))"
            Saved="OnFuelPlanSavedAsync" Reset="OnFuelPlanResetAsync"
            Closed="() => CloseFuelEditorAsync(editorIdentity)" />
    }
    @if (_sendPlanOpen && _sendPlanIdentity is { } sending)
    {
        <FuelSendPlan @key="sending" DispatchId="sending.Dispatch" ExecutionLegId="sending.Leg"
            TruckNumber="@(SelectedTruck?.UnitNumber ?? "")"
            Sent="() => OnFuelPlanSentAsync(sending)"
            Closed="() => CloseSendPlanAsync(sending)" />
    }
    @if (_routeEditorDispatch is { } editingRoute)
    {
        <RouteEditor @ref="_routeEditor" @key="_routeEditorSession" Session="_routeEditorSession" DispatchId="editingRoute"
            ExecutionLegId="_routeEditorExecutionLeg"
            TruckNumber="@(SelectedTruck?.UnitNumber ?? "")" MapChanged="PublishRouteEditorAsync"
            Saved="RouteChoiceSavedAsync" Closed="CloseRouteEditorAsync" />
    }
    <FleetTripChain Truck="SelectedTruck" Loads="_chainLoads"
                    Loading="_chainLoading" Failed="_chainFailed"
                    CurrentId="SelectedDispatchId"
                    RouteIndex="NextRouteIndex"
                    SelectedTrip="SelectedTrip"
                    Selected="ChooseChainLoadAsync"
                    StopSelected="ChooseChainStopAsync"
                    FocusedStopId="_tripStop"
                    Badges="StopBadges"
                    LoadHref="@(load => ReturnNavigation.Load(load.Id, ReturnOrigin))" />
    </div>

</div>
