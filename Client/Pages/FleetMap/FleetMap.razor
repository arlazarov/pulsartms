@page "/fleet/map"

<PageTitle>Fleet Map · PulsR</PageTitle>

<div class="fleet-map-page">
    <div class="fleet-map-page__background">
    <PageHeader Title="Fleet Map" />

    <fieldset class="fleet-map-toolbar filter-toolbar"
              disabled="@(_disposed || !_preferencesLoaded || _initializing)">
        <legend class="visually-hidden">Map filters</legend>
        <div class="fleet-map-search">
            <SearchInput Id="fleet-truck-search" Placeholder="Truck, driver or trailer" Value="@TruckSearch"
                         Options="SearchOptions" Changed="OnTruckSearchChanged" Selected="ChooseSearchTruckAsync" Enter="SearchEnterAsync" />
            @if (!string.IsNullOrWhiteSpace(TruckSearch))
            { <span class="visually-hidden" role="status">@MatchingTrucks.Count found</span> }
        </div>
        <button type="button" class="btn fleet-map-mobile-filters" aria-expanded="@(_mobileFiltersOpen ? "true" : "false")" aria-controls="fleet-map-filters" @onclick="() => _mobileFiltersOpen = !_mobileFiltersOpen">
            <ActionIcon Kind="filters" /><span>Filters</span>
        </button>
        <div id="fleet-map-filters" class="fleet-map-filters @(_mobileFiltersOpen ? "is-open" : "")">
        <div class="fleet-map-layer-controls"
             aria-busy="@(!_preferencesLoaded ? "true" : "false")"
             aria-hidden="@(!_preferencesLoaded ? "true" : "false")">
        <div class="fleet-map-layers" role="group" aria-label="Map layers">
        <label class="fleet-map-toggle filter-toolbar__toggle"
               title="Fuel Stations">
            <input
                type="checkbox" class="visually-hidden"
                aria-label="Fuel Stations"
                @bind="ShowFuelStations"
                @bind:after="OnFuelStationsToggleChanged" />
            <ActionIcon Kind="fuel" /><span>Fuel Stations</span>
        </label>

        <label class="fleet-map-toggle filter-toolbar__toggle"
               title="Traffic">
            <input
                type="checkbox" class="visually-hidden"
                aria-label="Traffic"
                @bind="ShowTraffic"
                @bind:after="OnTrafficToggleChanged" />

            <ActionIcon Kind="traffic" /><span>Traffic</span>
        </label>
        <label class="fleet-map-toggle filter-toolbar__toggle"
               title="Next loads">
            <input type="checkbox" class="visually-hidden"
                   aria-label="Next loads" @bind="ShowNextLoads"
                   @bind:after="OnNextLoadsChanged" />
            <ActionIcon Kind="route" /><span>Next loads</span>
        </label>
        </div>
        </div>
        @if (ShowNextLoads && _nextLoadsMessage is not null)
        {
            <span class="fleet-map-toolbar__status" role="status">@_nextLoadsMessage</span>
        }
        </div>
    </fieldset>
    @if (MapError is not null)
    {
        <p class="fleet-map-page__message" role="alert">
            @MapError
            <button class="btn btn--small" disabled="@_initializing" @onclick="StartMapAsync">Retry</button>
        </p>
    }
    @if (FocusError is not null) { <p class="fleet-map-page__message" role="status">@FocusError</p> }
    @if (TruckError is not null)
    {
        <p class="fleet-map-page__message" role="status">@TruckError</p>
    }
    @if (StationError is not null)
    {
        <p class="fleet-map-page__message" role="alert">@StationError <button class="btn btn--small" @onclick="OnDateChanged">Retry</button></p>
    }
    </div>
    <div class="fleet-map-stage">
    <div
        id="fleet-map"
        @ref="_mapElement"
        tabindex="-1"
        aria-label="Fleet and fuel station map"
        aria-busy="@_initializing">
    </div>
    <section class="fleet-map-info-reserved fleet-map-inspector
                    @(InspectorVisible ? "has-selection" : "")
                    @(_mobileTruckDetailsOpen
                        ? "is-mobile-expanded" : "is-mobile-collapsed")"
             aria-label="Map information"
             data-inspector-mode="@_inspectorMode.ToString().ToLowerInvariant()"
             @onkeydown="OnInspectorKeyDownAsync"
             @onkeydown:stopPropagation="true">
        <header class="fleet-map-inspector__header">
        @if (_inspectorMode == MapInspectorMode.Truck)
        {
            @* The unit names the card. Trailer and driver read as one quiet
               line beside it, the way a dispatcher says them out loud. *@
            <div class="fleet-map-inspector__identity">
                <strong class="fleet-map-inspector__title fleet-map-inspector__desktop-title">@(SelectedTruck is { } named ? named.UnitNumber : InspectorTitle)</strong>
                @if (SelectedTruck is { } identityTruck)
                {
                    <span class="fleet-map-inspector__crew">
                        <span class="fleet-map-inspector__trailer"
                              title="Trailer">@(string.IsNullOrWhiteSpace(
                            identityTruck.TrailerNumber)
                            ? "—" : identityTruck.TrailerNumber)</span>
                        <span class="fleet-map-inspector__driver"
                              title="Driver">@(string.IsNullOrWhiteSpace(
                            HosDriverName(identityTruck))
                            ? "—" : HosDriverName(identityTruck))</span>
                    </span>
                }
            </div>
            @if (SelectedTruck is not null)
            {
                @* When the truck arrives, and whether that is late, is the
                   one number the dispatcher is asked about. It reads in the
                   closed card; the cycle stays with the route below. *@
                <div class="fleet-map-inspector__arrival arrival-estimate"
                     aria-label="Estimated arrival at the next stop">
                    <ArrivalEstimate
                        Eta="@(_routeState?.Plan is { InputsChanged: false }
                            ? DisplayRouteState?.Eta : null)"
                        Stop="ScheduledStop" Memory="_headArrivalMemory"
                        DispatchId="SelectedDispatchId"
                        Refreshing="_etaRefreshPending"
                        Completed="@(_routeState?.Plan?.Tracking
                            .AllStopsPassed == true)"
                        ShowDutyStatus="false" ShowAppointment="false"
                        ShowDetails="false" />
                    @* No forecast is not always nothing to say: a truck
                       that has run out of route is standing at its stop. *@
                    <div class="fleet-map-inspector__arrival-placeholder
                                stop-hours">
                        <div class="stop-hours__row stop-hours__road">
                            <span class="stop-hours__label">ETA</span>
                            <span class="stop-hours__value"><span
                                class="stop-hours__arrival"><strong>@(AtNextStop
                                    ? "At stop" : "—")</strong>
                            </span></span>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <strong class="fleet-map-inspector__title">@InspectorTitle</strong>
            @if (HasTruckInspection)
            {
                <button type="button" class="btn btn--text btn--small fleet-map-inspector__back" @onclick="BackToTruckAsync">Back to truck</button>
            }
        }
        @if (_inspectorMode is MapInspectorMode.Truck
            or MapInspectorMode.NextStop || !HasTruckInspection)
        {
            <div class="fleet-map-inspector__controls">
                @if (_inspectorMode == MapInspectorMode.NextStop)
                {
                    <button type="button"
                            class="btn btn--text btn--small"
                            aria-expanded="@(_nextStopDetailsOpen
                                ? "true" : "false")"
                            aria-controls="fleet-map-next-load-details"
                            @onclick="ToggleNextStopDetails">
                        Details
                        <span aria-hidden="true">
                            @(_nextStopDetailsOpen ? "▴" : "▾")
                        </span>
                    </button>
                }
                @if (_inspectorMode == MapInspectorMode.Truck
                    || !HasTruckInspection)
                {
                    @if (_inspectorMode == MapInspectorMode.Truck)
                    {
                        @* A chevron, not a word: "Details"/"Hide" are
                           different widths, so the row moved as it opened. *@
                        <button type="button"
                                class="btn btn--text btn--small
                                    fleet-map-mobile-summary__toggle"
                                aria-expanded="@(_mobileTruckDetailsOpen
                                    ? "true" : "false")"
                                aria-controls="fleet-map-details"
                                aria-label="Truck details"
                                @onclick="ToggleMobileTruckDetails">
                        </button>
                    }
                    <button type="button"
                            class="btn btn--small fleet-map-inspector__close"
                            aria-label="Close map information"
                            @onclick="CloseInspectorAsync">×</button>
                }
            </div>
        }
        @if (_inspectorMode == MapInspectorMode.Truck && SelectedTruck is not null)
        {
            @* Second line of the card, under a rule: the four clocks as
               text, and at the far end the load being run and what is left
               of it. Whether the driver has hours decides whether any of
               the rest is worth reading, so it is never behind a
               disclosure. Last in the header, so the order on screen is
               the order in the document. *@
            <div class="fleet-map-inspector__hours">
                @* What the truck is running, said once: the load, its order,
                   and what is left to the next stop in both units. Each
                   number is also the control that copies it. *@
                @* Drawn whether or not the numbers have arrived: a group
                   that appears out of nothing pushes everything right of it
                   across the card as the load lands. *@
                <span class="fleet-map-mobile-summary__remaining"
                      aria-label="Load and order"
                      aria-busy="@(_loadDetails is null ? "true" : "false")">
                    @if (_loadDetails is { } runningLoad)
                    {
                        <button type="button"
                                class="fleet-map-route-info__copy-number"
                                title="Copy load number"
                                @onclick="() => CopyTextAsync(runningLoad.LoadNumber.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            <Client.Shared.Dispatch.LoadNumber.LoadNumber
                                Value="runningLoad.LoadNumber" />
                        </button>
                    }
                    else
                    {
                        <span class="fleet-map-inspector__value">—</span>
                    }
                    <span class="fleet-map-mobile-summary__order">
                        <span class="fleet-map-mobile-summary__label">Order</span>
                        <button type="button"
                                class="fleet-map-route-info__copy-number"
                                title="Copy order number"
                                disabled="@(string.IsNullOrWhiteSpace(_loadDetails?.OrderNumber))"
                                @onclick="() => CopyTextAsync(_loadDetails?.OrderNumber ?? string.Empty)">
                            <strong class="fleet-map-inspector__value">@(string.IsNullOrWhiteSpace(_loadDetails?.OrderNumber) ? "—" : _loadDetails.OrderNumber)</strong>
                        </button>
                    </span>
                </span>
                @* What is left, in the middle of the line and shown as well
                   as said: the bar is how much of the run is behind the
                   truck. It reads as one phrase, so it never breaks
                   between a number and its unit. *@
                <span class="fleet-map-mobile-summary__distance"
                      aria-label="@(AtNextStop
                          ? "At the stop, no distance left of the run"
                          : $"{Units.FormatDistance(RemainingMiles)} left of the run")">
                    @* The line names a thing before it says it - Order,
                       Break, Drive - and this is no different. *@
                    <span class="fleet-map-mobile-summary__distance-text"
                          aria-hidden="true"><span
                            class="fleet-map-mobile-summary__label">Left&#160;</span><strong>@Units.DistanceValue(RemainingMiles)</strong><span
                            class="fleet-map-mobile-summary__label">&#160;@Units.DistanceUnit</span>@if (Units.BothDistances)
                        {<span class="fleet-map-mobile-summary__label fleet-map-mobile-summary__alternate">&#160;·&#160;@Units.Kilometers(RemainingMiles)&#160;km</span>}
                    </span>
                    @* The track is always drawn, so a run whose progress is
                       not known yet reserves the same height as one that
                       is, and the card does not grow under the pointer. *@
                    <span class="fleet-map-mobile-summary__bar"
                          aria-hidden="true">
                        <span style="inline-size: @(Math.Round((RouteCovered ?? 0) * 100))%"></span>
                    </span>
                </span>
                @* The label travels with the clocks it names. Apart, "HOS"
                   sat beside the load and the clocks sat a card-width away. *@
                <span class="fleet-map-inspector__clocks">
                    <span class="fleet-map-inspector__hours-label">HOS</span>
                    <Client.Shared.DriverStatus.DriverHours.DriverHours
                        @key="_activeTruckId" Clocks="_hos"
                        Dials="false" ShowDutyStatus="false" />
                </span>
            </div>
        }
        </header>
        <div class="fleet-map-inspector__native" hidden="@(_inspectorMode is not (MapInspectorMode.Stop or MapInspectorMode.Fuel))"></div>
        @if (HasTruckInspection)
        {
            <div id="fleet-map-details" class="fleet-map-info-content" hidden="@(_inspectorMode != MapInspectorMode.Truck)">
    <div id="fleet-map-route-details" class="fleet-map-route-details">
    @if (_routeLoading || _loadDetails is not null || ScheduledStop is not null || _routeState?.Plan is not null)
    {
        var routePlan = _routeState?.Plan is { InputsChanged: false } availablePlan ? availablePlan : null;
        var nextStop = ScheduledStop;
        <div class="fleet-map-route-info @(routePlan is null ? "is-awaiting-route" : "") @(NextStopIsFinal ? "has-final-stop" : "")" aria-label="Current dispatch route" aria-busy="@(_routeLoading ? "true" : "false")">
            <div class="fleet-map-route-info__visit">
            <div class="fleet-map-route-info__next">
                <div class="fleet-map-route-info__visit-heading">
                    <span class="fleet-map-route-info__label">@(!string.IsNullOrWhiteSpace(nextStop?.Job) ? nextStop.Job
                        : routePlan?.Tracking.NextStopLabel.Contains('·') == true ? routePlan.Tracking.NextStopLabel.Split('·')[0].Trim() : "Next stop")</span>
                    <span class="fleet-map-route-info__distance" title="Distance to next stop" aria-label="@($"Distance to next stop: {Units.FormatDistance(routePlan is null ? null : NextStopMiles)}")">
                        <span aria-hidden="true">·</span>
                        <strong>@Units.DistanceValue(routePlan is null ? null : NextStopMiles) <small>@Units.DistanceUnit</small></strong>
                        @if (Units.BothDistances) { <span class="fleet-map-route-info__secondary">· @Units.Kilometers(routePlan is null ? null : NextStopMiles) km</span> }
                    </span>
                </div>
                @if (nextStop is not null && !string.IsNullOrWhiteSpace(nextStop.Address))
                {
                    var address = Client.Services.StopAddressLines.Create(nextStop.Address);
                    <button type="button" class="fleet-map-route-info__copy-address" title="Copy full address" @onclick="() => CopyTextAsync(nextStop.Address)">
                        <span class="fleet-map-route-info__address-lines"
                              title="@nextStop.Address">
                            @if (!string.IsNullOrWhiteSpace(nextStop.Name))
                            { <span class="fleet-map-route-info__facility">@nextStop.Name.Trim()</span> }
                            <span class="fleet-map-route-info__street">
                                @address.Street
                            </span>
                            @if (address.Locality.Length > 0)
                            { <strong class="fleet-map-route-info__address">@address.Locality</strong> }
                        </span>
                    </button>
                    @if (_addressCopyMessage is not null) { <span class="fleet-map-route-info__secondary" role="status">@_addressCopyMessage</span> }
                }
                else
                {
                    <span class="fleet-map-route-info__copy-address">
                        <span class="fleet-map-route-info__address-lines">
                            @if (!string.IsNullOrWhiteSpace(nextStop?.Name))
                            { <span class="fleet-map-route-info__facility">@nextStop.Name.Trim()</span> }
                            else if (nextStop is null && _routeLoading)
                            { <span class="fleet-map-route-info__facility" aria-hidden="true">—</span> }
                            <span>—</span><strong>@(routePlan?.Tracking.NextStopId.HasValue == true ? routePlan.Tracking.NextStopLabel : "—")</strong>
                        </span>
                    </span>
                }
            </div>
            @{ var appointment = FleetAppointmentDisplay.Split(ScheduledStop); }
            <div class="fleet-map-route-info__appointment fleet-map-route-info__delivery">
                <span class="fleet-map-route-info__label">@(ScheduledStop?.Job.Contains("pick", StringComparison.OrdinalIgnoreCase) == true ? "Pickup" : ScheduledStop?.Job.Contains("drop", StringComparison.OrdinalIgnoreCase) == true || ScheduledStop?.Job.Contains("deliver", StringComparison.OrdinalIgnoreCase) == true ? "Delivery" : "Stop")</span>
                <strong>
                    @if (appointment.Date is not null)
                    {
                        <span
                            class="fleet-map-route-info__appointment-date"
                            data-separator="· "
                        >@appointment.Date</span><span
                            class="fleet-map-route-info__appointment-separator"
                        > · </span>
                    }
                    <span
                        class="fleet-map-route-info__appointment-time"
                    >@appointment.Value</span>
                </strong>
            </div>
            </div>
            @* The load, its order and the distance to the next stop are in
               the card head, so none of them is said again here. *@
            <div class="fleet-map-route-info__distances">
            <div class="fleet-map-route-info__metric">
                @* What is left is in the card head, drawn against this
                   total; here the total itself, which the bar cannot say. *@
                <span class="fleet-map-route-info__label">Run</span>
                <span class="fleet-map-route-info__progress">
                    <strong>@Units.DistanceValue(routePlan?.OriginalPlannedMiles)</strong>
                    <span class="fleet-map-route-info__total">@Units.DistanceUnit</span>
                    @if (Units.BothDistances) { <span class="fleet-map-route-info__secondary">· @Units.Kilometers(routePlan?.OriginalPlannedMiles) km</span> }
                </span>
            </div>
            </div>
            <div class="fleet-map-route-info__timing">
            <div class="arrival-estimate">
                @* ETA reads in the card head, so this section keeps only the
                   cycle, next to the delivery window it is measured against.
                   Inspecting a next stop takes the head over; the route then
                   carries its own arrival again rather than losing it. *@
                <ArrivalEstimate Eta="@(routePlan is null ? null : DisplayRouteState?.Eta)" Stop="ScheduledStop" Memory="_arrivalMemory" DispatchId="SelectedDispatchId" Refreshing="_etaRefreshPending" Completed="@(routePlan?.Tracking.AllStopsPassed == true)" ShowDutyStatus="false" ShowAppointment="false" ShowSummary="@(_inspectorMode != MapInspectorMode.Truck)" />
                <div class="fleet-map-route-info__eta-placeholder stop-hours">
                    <section class="stop-hours__cycle" aria-label="Cycle at this stop"><div class="stop-hours__row stop-hours__arrival-cycle"><h3 class="stop-hours__heading">Cycle remaining</h3><strong class="stop-hours__value">—</strong></div></section>
                </div>
            </div>
            <div class="fleet-map-route-info__arrival-fuel">
                <span class="fleet-map-route-info__label">Fuel on arrival</span>
                <span class="fleet-map-route-info__fuel-value">
                @if (ScheduledFuelArrival is { } fuelArrival)
                {
                    <strong>@Math.Round(fuelArrival.Percent)%</strong>
                    <span class="fleet-map-route-info__secondary">@Math.Round(fuelArrival.Gallons) US gal</span>
                }
                else
                {
                    <strong>—</strong>
                }
                </span>
            </div>
            </div>
            <div class="fleet-map-route-info__messages">
                @foreach (var warning in routePlan?.Route.Warnings ?? [])
                { <span class="fleet-map-route-info__error" role="status">@Client.Shared.RouteMessageDisplay.Concise(warning)</span> }
                @if (routePlan is not null && (_routeState?.Progress?.OffRoute == true || _routeState?.Progress?.LocationStale == true))
                {
                    <div class="fleet-map-route-info__status" role="status">
                        @if (_routeState?.Progress?.OffRoute == true) { <span>Off planned route</span> }
                        @if (_routeState?.Progress?.LocationStale == true) { <span>GPS unavailable or stale</span> }
                    </div>
                }
                @if (VisibleRouteError is { } plannedRouteError)
                { <span class="fleet-map-route-info__error" role="status">@plannedRouteError</span> }
            </div>

        </div>
    }
    @if (VisibleRouteError is { } emptyRouteError && _routeState?.Plan is null && _loadDetails is null) { <p class="fleet-map-route-info__error" role="status">@emptyRouteError</p> }
    </div>
    @* The drawing puts the actions under the detail they act on, with the
       words that say what they do rather than six bare icons. *@
    @if (SelectedTruck is { } headerTruck)
    {
        <div class="fleet-map-inspector__actions" role="group" aria-label="Truck actions">
            <button type="button"
                    class="btn map-action-icon
                        @(_followingTruck ? "btn--primary" : "")"
                    title="Follow" aria-label="Follow"
                    aria-pressed="@(_followingTruck ? "true" : "false")"
                    @onclick="ToggleFollowAsync">
                <ActionIcon Kind="follow" /><span>Follow</span>
            </button>
            <button type="button" class="btn map-action-icon"
                    title="Show route" aria-label="Show route"
                    disabled="@(!CanShowRoute)"
                    @onclick="ShowRouteAsync">
                <ActionIcon Kind="route-overview" /><span>Fit route</span>
            </button>
            <button type="button" class="btn map-action-icon" title="Fuel plan" aria-label="Fuel plan" disabled="@(!CanEditFuel || _fuelEditorOpen || _recalculatingFuel)" @onclick="OpenFuelEditorAsync"><ActionIcon Kind="fuel" /><span>Fuel</span></button>
            <button type="button" class="btn map-action-icon" title="Camera" aria-label="Camera" @onclick="OpenCameraAsync"><ActionIcon Kind="camera" /><span>Camera</span></button>
            <button type="button" class="btn map-action-icon" title="Route options" aria-label="Route options"
                    disabled="@(_fuelEditorOpen || SelectedDispatchId is null)" @onclick="OpenSelectedRouteEditorAsync"><ActionIcon Kind="route" /><span>Route options</span></button>
            <a class="btn map-action-icon"
               href="@(SelectedDispatchId is { } detailsDispatchId
                   ? $"/dispatch/{detailsDispatchId}" : null)"
               title="@("Route & load details")"
               aria-label="@("Route & load details")"
               aria-disabled="@(SelectedDispatchId is null
                   ? "true" : null)">
                <ActionIcon Kind="external-link" /><span>Open load</span>
            </a>
        </div>
    }
    @if (SelectedTruck is { } truck)
    {
        <div id="fleet-map-telemetry-details">
        @* One line for the vehicle itself: what it is doing right now, and
           where it is. It is the last thing a dispatcher reads, so it gets
           one line rather than a block of its own. *@
        <div class="fleet-map-truck-info" aria-label="Selected truck">
            <span class="fleet-map-truck-info__kind">Vehicle</span>
            <div class="fleet-map-truck-info__telemetry"
                 aria-label="Current truck readings">
                <span class="fleet-map-truck-info__reading
                             fleet-map-truck-info__reading--speed
                             @TelemetryTone.Speed(truck.Speed)">
                    <small><ActionIcon Kind="speed" /><span>Speed</span></small>
                    <strong>@truck.Speed.ToString("N0") <small>mph</small>
                    </strong>
                </span>
                <span class="fleet-map-truck-info__reading
                             fleet-map-truck-info__reading--fuel">
                    <FuelReading Percent="@((double?)truck.FuelPercent)"
                                 Variant="metric" />
                </span>
                <span class="fleet-map-truck-info__reading
                    @TelemetryTone.Engine(truck.Speed, truck.EngineState)">
                    <small><ActionIcon Kind="engine" /><span>Engine</span>
                    </small>
                    <strong>@(string.IsNullOrWhiteSpace(truck.EngineState)
                        ? "—" : truck.EngineState)</strong>
                </span>
                <Client.Shared.Trucks.TruckWeather.TruckWeather
                    TruckId="truck.TruckId"
                    Visibility="_visibility"
                    OwnerCancellation="_lifetime.Token"
                    Current="@(SelectedDate == DateOnly.FromDateTime(
                        DateTime.Today))" />
            </div>
            <div id="fleet-map-truck-location"
                 class="fleet-map-truck-info__location"
                 aria-label="Truck GPS location">
                <span>@TruckLocationLabel</span>
                @if (string.IsNullOrWhiteSpace(truck.FormattedLocation))
                {
                    <strong>Address unavailable</strong>
                }
                else
                {
                    <strong>
                        <button type="button"
                            class="fleet-map-route-info__copy-number"
                            title="Copy location address"
                            @onclick="() => CopyTextAsync(
                                truck.FormattedLocation)">
                            @truck.FormattedLocation
                        </button>
                    </strong>
                }
            </div>
        </div>
        </div>
    }

            </div>
        }
        @if (_inspectorMode == MapInspectorMode.NextStop && InspectedRoute is { } inspected)
        {
            <button class="btn btn--text btn--small"
                @onclick="() => OpenRouteEditorAsync(inspected.Id,
                    inspected.ExecutionLegId)">
                Route options · <LoadNumber Value="inspected.LoadNumber" />
            </button>
            <NextLoadDetailsCard Embedded="true" Route="inspected" Stop="InspectedStop" StopIndex="_inspectedStopIndex"
                Expanded="_nextStopDetailsOpen"
                FuelArrival="InspectedFuelArrival"
                DistanceMiles="InspectedDistanceMiles"
                Details="_inspectedDetails" Eta="InspectedEta" Refreshing="InspectedEtaRefreshing" Loading="@(_inspectedDetailsRequest is not null)"
                Error="@_inspectedDetailsError" CopyMessage="@_addressCopyMessage"
                OnCopy="CopyTextAsync" OnClose="BackToTruckAsync" />
        }
    </section>

    @if (SelectedTruck is { } cameraTruck)
    {
        <TruckCamera @ref="_truckCamera" @key="cameraTruck.TruckId" TruckId="cameraTruck.TruckId"
            TruckNumber="@cameraTruck.UnitNumber" ShowTrigger="false" OpenChanged="OnCameraOpenChangedAsync" />
    }

    @if (!_fuelEditorOpen && (ShowFuelStations
        || _routeState?.Plan is not null || SelectedTruck is not null))
    {
        @* On a phone the key ate the corner of the map it explains, so it
           folds behind one chip there and stays open everywhere else. *@
        <aside class="fleet-map-key @(_keyOpen ? "is-open" : "")"
               aria-label="Map key">
            <button type="button" class="btn fleet-map-key__toggle"
                    aria-expanded="@(_keyOpen ? "true" : "false")"
                    aria-controls="fleet-map-key-content"
                    aria-label="Map key"
                    @onclick="() => _keyOpen = !_keyOpen">?</button>
            <div id="fleet-map-key-content" class="fleet-map-key__content">
            @if (_routeState?.Plan is not null)
            {
                <div class="fleet-map-key__routes">
                    <span><i class="fleet-map-key__line" aria-hidden="true"></i>Current route</span>
                    @if (ShowNextLoads)
                    { <span><i class="fleet-map-key__line fleet-map-key__line--next" aria-hidden="true"></i>Next loads · color by load</span> }
                    <span><i class="fleet-map-key__stop" aria-hidden="true">1</i>Pickup / delivery</span>
                    @if (ShowFuelStations || Usable(_routeState?.Plan?.FuelPlan))
                    { <span><i class="fleet-map-key__planned" aria-hidden="true">Fuel</i>Planned fuel</span> }
                </div>
            }
            @if (ShowFuelStations)
            {
                <div class="fleet-map-key__fuel">
                    <span class="fleet-map-key__fuel-label">Fuel price</span>
                    <span class="fleet-map-key__scale"><span>Cheap</span><i aria-hidden="true"></i><span>Expensive</span></span>
                    <span class="fleet-map-key__note">Within each currency · zoom in for stations</span>
                    <span class="fleet-map-key__missing"><i aria-hidden="true"></i>No price</span>
                </div>
            }
            @if (SelectedTruck is not null
                && SelectedDate == DateOnly.FromDateTime(DateTime.Today))
            {
                <small class="fleet-map-weather-source">
                    Source: Includes weather data from Google
                </small>
            }
            </div>
        </aside>
    }
    @if (_fuelEditorOpen && _fuelEditorIdentity is { } editorIdentity)
    {
        <FuelPlanEditor @key="editorIdentity" TruckId="editorIdentity.Truck" DispatchId="editorIdentity.Dispatch"
            ExecutionLegId="editorIdentity.Leg"
            AssignmentRevision="editorIdentity.Revision"
            InitialCalculatedAt="_routeState?.Plan?.FuelPlan?.CalculatedAt"
            TruckNumber="@(SelectedTruck?.UnitNumber ?? "")" Station="_fuelEditorStation"
            StationSelected="@(station => OnFuelEditorStationSelectedAsync(editorIdentity, station))"
            BusyChanged="@(busy => OnFuelEditorBusyChangedAsync(editorIdentity, busy))"
            Failed="@(() => OnFuelEditorFailedAsync(editorIdentity))"
            Saved="OnFuelPlanSavedAsync" Reset="OnFuelPlanResetAsync"
            Closed="() => CloseFuelEditorAsync(editorIdentity)" />
    }
    @if (_routeEditorDispatch is { } editingRoute)
    {
        <RouteEditor @ref="_routeEditor" @key="_routeEditorSession" Session="_routeEditorSession" DispatchId="editingRoute"
            ExecutionLegId="_routeEditorExecutionLeg"
            TruckNumber="@(SelectedTruck?.UnitNumber ?? "")" MapChanged="PublishRouteEditorAsync"
            Saved="RouteChoiceSavedAsync" Closed="CloseRouteEditorAsync" />
    }
    </div>

</div>
