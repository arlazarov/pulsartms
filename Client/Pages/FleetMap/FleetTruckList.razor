@using Client.Shared.Trucks
@* the trucks the page already has, filtered by
   the page's own truck search. Choosing one takes the same path as
   choosing it in search. *@
@if (Collapsed)
{
    <section class="fleet-truck-list is-collapsed" aria-label="Fleet list, hidden">
        <button type="button" class="btn fleet-truck-list__expand"
                aria-expanded="false" aria-controls="fleet-truck-list-rows"
                title="Show the fleet list"
                @onclick="() => CollapsedChanged.InvokeAsync(false)">
            <ActionIcon Kind="truck" />
            <span>Fleet · @Total</span>
        </button>
    </section>
}
else
{
<section class="fleet-truck-list" aria-labelledby="fleet-truck-list-title">
    <header class="fleet-truck-list__header">
        <h2 id="fleet-truck-list-title">Fleet · @Total</h2>
        <button type="button" class="btn btn--small fleet-truck-list__collapse"
                aria-expanded="true" aria-controls="fleet-truck-list-rows"
                title="Hide the fleet list to widen the map"
                @onclick="() => CollapsedChanged.InvokeAsync(true)">Hide</button>
    </header>
    <div class="fleet-truck-list__body" id="fleet-truck-list-rows">
        @if (Trucks.Count == 0)
        {
            <p class="fleet-truck-list__empty">
                @(Total == 0 ? "No trucks to show." : "No trucks match the search and filter.")
            </p>
        }
        else
        {
            <div class="fleet-truck-list__columns" aria-hidden="true">
                <span>Truck</span><span>Trailer</span><span>Driver</span>
            </div>
            <ul class="fleet-truck-list__rows">
                @foreach (var truck in Trucks)
                {
                    var selected = truck.TruckId == SelectedId;
                    var moving = TruckMotion.IsMoving(truck.Speed);
                    @* Green while the truck moves or its engine runs,
                       idling included (the owner, September 28); the
                       Moving / Stopped chips still go by motion alone. *@
                    var running = TelemetryTone.Running(truck.Speed,
                        truck.EngineState);
                    <li @key="truck.TruckId">
                        <button type="button"
                                class="fleet-truck-list__row @(selected ? "is-selected" : "")"
                                aria-pressed="@(selected ? "true" : "false")"
                                @onclick="() => Selected.InvokeAsync(truck.TruckId)">
                            <span class="fleet-truck-list__unit">
                                <span class="fleet-truck-list__motion
                                             @(running ? "is-moving" : "is-stopped")"
                                      title="@(moving ? "Moving"
                                          : running ? "Stopped, engine on"
                                          : "Stopped")"
                                      aria-hidden="true"></span>
                                <strong>@truck.UnitNumber</strong>
                            </span>
                            @* The trailer number alone; a disagreement between
                               sources is the truck card's to explain. *@
                            <span class="fleet-truck-list__trailer">@Trailer(truck)</span>
                            <span class="fleet-truck-list__driver">@Text(truck.DriverName)</span>
                            <span class="fleet-truck-list__speed">@SpeedText(truck)</span>
                        </button>
                    </li>
                }
            </ul>
        }
    </div>
    <footer class="fleet-truck-list__foot">
        Showing @Trucks.Count of @Total
    </footer>
</section>
}
