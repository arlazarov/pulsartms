@using Client.Shared.Dispatch
@* Futuristic interface only: every trip of the selected truck, as the
   Dispatch board places them (server order and work phase), with its stops
   as the map labels them. A trip or one of its stops chooses what the panel
   under the truck shows in full. *@
<section class="fleet-trip-chain" aria-labelledby="fleet-trip-chain-title">
    <div class="fleet-trip-chain__label">
        <span class="fleet-trip-chain__eyebrow">Trip chain</span>
        <h2 id="fleet-trip-chain-title">
            @(Truck is null ? "No truck selected" : $"Truck {Truck.UnitNumber}")
        </h2>
    </div>
    @if (Truck is null)
    {
        <p class="fleet-trip-chain__hint">
            Choose a truck on the map, in the list or with search.
        </p>
    }
    else if (Loading)
    {
        <p class="fleet-trip-chain__hint" role="status">Reading the truck's loads…</p>
    }
    else if (Failed)
    {
        <p class="fleet-trip-chain__hint" role="status">
            The truck's loads could not be read; retrying with the board.
        </p>
    }
    else if (Loads.Count == 0)
    {
        <p class="fleet-trip-chain__hint">No active or planned loads.</p>
    }
    else
    {
        @if (Loads.Count > 1)
        {
            @* The chain scrolls sideways on a narrow screen; these say so
               and move through it a trip at a time. *@
            <div class="fleet-trip-chain__nav" role="group" aria-label="Move through the trip chain">
                <button type="button" class="btn btn--small fleet-trip-chain__step is-back"
                        aria-label="Previous trip" disabled="@(_position <= 0)"
                        @onclick="() => MoveAsync(-1)">
                    <ActionIcon Kind="chevron-right" />
                </button>
                <span class="fleet-trip-chain__position" aria-live="polite">
                    @(_position + 1) of @Loads.Count
                </span>
                <button type="button" class="btn btn--small fleet-trip-chain__step"
                        aria-label="Next trip" disabled="@(_position >= Loads.Count - 1)"
                        @onclick="() => MoveAsync(1)">
                    <ActionIcon Kind="chevron-right" />
                </button>
            </div>
        }
        <ol class="fleet-trip-chain__links">
            @foreach (var (load, index) in Loads.Select((load, i) => (load, i)))
            {
                var label = DispatchWorkPhase.Label(load);
                var conflict = DispatchWorkPhase.ConflictText(load.WorkConflict);
                var selected = IsSelected(load);
                <li class="fleet-trip-chain__link @PhaseClass(load) @(selected ? "is-selected" : "")"
                    @key="(load.Id, load.ExecutionLegId)">
                    @if (index > 0) { <ActionIcon Kind="chevron-right" /> }
                    <span class="fleet-trip-chain__number" aria-hidden="true">@(index + 1)</span>
                    <div class="fleet-trip-chain__card">
                        <button type="button" class="fleet-trip-chain__trip"
                                aria-pressed="@(selected ? "true" : "false")"
                                @ref="_cards[index]"
                                @onfocus="() => _position = index"
                                @onclick="() => Selected.InvokeAsync(load)">
                            <span class="fleet-trip-chain__load">
                                <Client.Shared.Dispatch.LoadNumber.LoadNumber Value="load.LoadNumber" />
                            </span>
                            @if (!string.IsNullOrEmpty(label))
                            { <span class="fleet-trip-chain__phase">@label</span> }
                            <span class="fleet-trip-chain__lane">@Lane(load)</span>
                            @if (conflict is not null)
                            { <span class="fleet-trip-chain__conflict" role="status">@conflict</span> }
                        </button>
                        <span class="fleet-trip-chain__stops" role="group"
                              aria-label="@($"Stops of load {load.LoadNumber}")">
                            @foreach (var visit in DispatchStopPresentation.OrderedVisits(load.Stops))
                            {
                                var stop = visit.Stop;
                                var focused = selected && stop.Id == FocusedStopId;
                                <button type="button"
                                        class="fleet-trip-chain__stop @DispatchStopPresentation.Tone(stop) @(stop.IsCompleted ? "is-done" : "")"
                                        aria-pressed="@(focused ? "true" : "false")"
                                        aria-label="@($"{visit.Marker}: {stop.Job}, {DispatchBoardRow.Location(stop)}")"
                                        title="@($"{stop.Job} · {DispatchBoardRow.Location(stop)}")"
                                        @onclick="() => StopSelected.InvokeAsync((load, stop.Id))"
                                        >@visit.Marker</button>
                            }
                        </span>
                    </div>
                </li>
            }
            @if (!NextLoadsShown && Loads.Count > 1)
            {
                <li class="fleet-trip-chain__link">
                    <button type="button" class="btn btn--small"
                            @onclick="ShowNextLoads">Show next loads on the map</button>
                </li>
            }
        </ol>
    }
</section>
