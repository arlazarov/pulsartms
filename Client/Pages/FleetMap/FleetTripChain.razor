@* Futuristic interface only: the selected truck's current load, then the
   next loads in the order the server sends them. Choosing a next load opens
   its stop card through the map, the same path as clicking its stop. *@
<section class="fleet-trip-chain" aria-labelledby="fleet-trip-chain-title">
    <div class="fleet-trip-chain__label">
        <span class="fleet-trip-chain__eyebrow">Trip chain</span>
        <h2 id="fleet-trip-chain-title">
            @(Truck is null ? "No truck selected" : $"Truck {Truck.UnitNumber}")
        </h2>
    </div>
    @if (Truck is null)
    {
        <p class="fleet-trip-chain__hint">
            Choose a truck on the map, in the list or with search.
        </p>
    }
    else
    {
        <ol class="fleet-trip-chain__links">
            @if (Current is { } current)
            {
                <li class="fleet-trip-chain__link is-current">
                    <span class="fleet-trip-chain__number" aria-hidden="true">1</span>
                    <button type="button" class="fleet-trip-chain__card"
                            aria-pressed="@(InspectedLoadId is null ? "true" : "false")"
                            @onclick="CurrentSelected">
                        <span class="fleet-trip-chain__load">
                            <Client.Shared.Dispatch.LoadNumber.LoadNumber Value="current.LoadNumber" />
                        </span>
                        <span class="fleet-trip-chain__phase">Current</span>
                        <span class="fleet-trip-chain__lane">@Lane(current)</span>
                    </button>
                </li>
            }
            else if (CurrentLoading)
            {
                <li class="fleet-trip-chain__link is-current">
                    <span class="fleet-trip-chain__hint">Reading the current load…</span>
                </li>
            }
            else
            {
                <li class="fleet-trip-chain__link">
                    <span class="fleet-trip-chain__hint">No current load.</span>
                </li>
            }
            @if (NextLoadsShown)
            {
                var index = 1;
                foreach (var route in Next)
                {
                    var position = ++index;
                    var inspected = InspectedLoadId == route.Id
                        && InspectedLegId == route.ExecutionLegId;
                    <li class="fleet-trip-chain__link @(position == 2 ? "is-next" : "is-upcoming")"
                        @key="(route.Id, route.ExecutionLegId)">
                        <ActionIcon Kind="chevron-right" />
                        <span class="fleet-trip-chain__number" aria-hidden="true">@position</span>
                        <button type="button" class="fleet-trip-chain__card"
                                aria-pressed="@(inspected ? "true" : "false")"
                                @onclick="() => NextSelected.InvokeAsync(route)">
                            <span class="fleet-trip-chain__load">
                                <Client.Shared.Dispatch.LoadNumber.LoadNumber Value="route.LoadNumber" />
                            </span>
                            <span class="fleet-trip-chain__phase">@(position == 2 ? "Next" : "Upcoming")</span>
                            <span class="fleet-trip-chain__lane">@Lane(route)</span>
                        </button>
                    </li>
                }
            }
            else
            {
                <li class="fleet-trip-chain__link">
                    <button type="button" class="btn btn--small"
                            @onclick="ShowNextLoads">Show next loads</button>
                </li>
            }
        </ol>
    }
</section>
