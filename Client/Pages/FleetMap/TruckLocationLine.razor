@* Where the truck is, as its telemetry names it: the pin and its label,
   the address under them, copied by a click. Missing is said, never
   filled from a stop or another truck. *@
<div id="fleet-map-truck-location"
     class="fleet-map-inspector__location"
     aria-label="Truck GPS location">
    <ActionIcon Kind="location" />
    <span>@Label</span>
    @if (string.IsNullOrWhiteSpace(Address))
    {
        <strong>Address unavailable</strong>
    }
    else
    {
        <strong>
            <button type="button"
                class="fleet-map-route-info__copy-number"
                title="Copy location address"
                @onclick="() => OnCopy.InvokeAsync(Address)">
                @Address
            </button>
        </strong>
    }
</div>
