@page "/users/{Id:guid}/edit"
@attribute [Authorize(Roles = "Admin")]
@using Client.Components.Form
@using Client.Pages.Base
@inherits FormPage

<PageTitle>Edit User</PageTitle>

<section class="add-user-page">
    <PageHeader Title="Edit User" />

    @if (IsLoading)
    {
        <div>Loading...</div>
    }
    else if (!string.IsNullOrWhiteSpace(LoadError))
    {
        <div class="add-user-page__error">
            @LoadError
        </div>
    }
    else
    {
        <Form
            Model="@Model"
            OnSubmit="UpdateUserAsync"
            OnCancel="Cancel"
            SubmitText="Save Changes"
            IsSaving="@IsSaving"
            Errors="@Errors">

            <FormField
                Label="Name"
                For="name"
                HasError="@HasError("Name")">

                <InputText
                    id="name"
                    @bind-Value="Model.Name" />
            </FormField>

            <FormField
                Label="Email"
                For="email"
                HasError="@HasError("Email")">

                <InputText
                    id="email"
                    type="email"
                    @bind-Value="Model.Email" />
            </FormField>

            <FormField
                Label="Password"
                For="password"
                HasError="@HasError("Password")">

                <InputText
                    id="password"
                    type="password"
                    @bind-Value="Model.Password"
                    autocomplete="new-password"
                    placeholder="Leave blank to keep current password" />
            </FormField>

            <FormField Label="Role" For="role" HasError="@HasError("Role")">
                <InputSelect id="role" @bind-Value="Model.Role">
                    <option value="Dispatch">Dispatch</option>
                    <option value="Admin">Admin</option>
                </InputSelect>
            </FormField>
            <label class="form-field__checkbox">
                <InputCheckbox @bind-Value="Model.IsActive" /> Active account
            </label>
        </Form>
    }
</section>
