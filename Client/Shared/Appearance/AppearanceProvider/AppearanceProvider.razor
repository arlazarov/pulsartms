@if (_ready)
{
    <CascadingValue Value="this">
        <CascadingValue Value="Units">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
}
else
{
    <div class="appearance-loader" role="status">
        <span class="visually-hidden">Loading…</span>
        <span class="appearance-loader__dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </span>
    </div>
}
