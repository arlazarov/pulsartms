@if (Variant == "fact")
{
    @* The outside temperature as one of the truck panel's facts. *@
    <div class="fleet-truck-facts__fact truck-weather truck-weather--@Icon"
         aria-label="Outside temperature" title="@Title">
        <ActionIcon Kind="@Icon" />
        <div><dt>Temperature</dt><dd>@Value</dd></div>
    </div>
}
else
{
    <div class="truck-readings__reading truck-readings__reading--outside
                truck-weather truck-weather--@Icon"
         aria-label="Outside temperature" title="@Title">
        <small>
            <ActionIcon Kind="@Icon" /><span>Temp</span>
        </small>
        <strong>@Value</strong>
    </div>
}
