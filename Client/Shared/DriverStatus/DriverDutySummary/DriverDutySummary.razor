@using Client.Models.DTO.Planning
@if (Reading == "row")
{
    @* One line under the clocks: the status and how long it has lasted,
       then - only while the driver rests - the rest built up so far,
       counted against the daily rest and the cycle reset. The two are
       different durations: a sleeper period after off duty and personal
       conveyance is one rest block, longer than the status itself. *@
    <div class="driver-duty driver-duty--row"
         aria-label="Current duty and rest">
        <span class="driver-duty__status">
            <ActionIcon Kind="@StatusIcon" />
            <strong>@ShortLabel(ShownStatus)</strong>
            @if (Fresh && Matches && Status?.StatusMinutes is { } elapsed)
            { <span>· @Duration(elapsed)</span> }
        </span>
        @if (Fresh && Matches
            && Status?.DailyRestRemainingMinutes is { } rest)
        {
            <span class="driver-duty__rest"
                  title="@RestTitle">@(rest > 0
                ? $"10h rest in {Duration(rest)}"
                : "10h rest done")</span>
        }
        @if (Fresh && Matches && ResetRemaining is { } reset)
        {
            <span class="driver-duty__rest"
                  title="@ResetTitle">@reset</span>
        }
    </div>
}
else
{
<div class="driver-duty" aria-label="Current driver duty status">
    <div class="driver-duty__current">
        <span class="driver-duty__label">@(Compact ? "HOS ·" : "HOS status:")</span>
        <span><strong>@Label(string.IsNullOrEmpty(CurrentStatus) ? Status?.Status : CurrentStatus)</strong>@if (Fresh && Matches && Status?.StatusMinutes is { } minutes) { <span>@(Compact ? " · " : " for ")@StatusDuration(minutes)</span> }</span>
    </div>
    @if (ShowRestDetails && Fresh && Matches && Status?.DailyRestRemainingMinutes is { } remaining)
    {
        <span>@(remaining > 0 ? $"{Duration(remaining)} left to complete 10h rest" : "10h rest reached")</span>
        @if (CycleResetText is { } reset)
        {
            <span class="driver-duty__cycle-reset">@reset</span>
        }
    }
</div>
}
