@using Client.Components.Popup
<div class="driver-group-picker">
    <label for="@Id" class="visually-hidden">Drivers shown</label>
    <select id="@Id" value="@(Groups.View?.Selected?.ToString() ?? "")"
            disabled="@(_busy || Groups.View is null)" @onchange="ChooseAsync"
            title="@Title">
        <option value="">All drivers</option>
        @foreach (var group in Groups.View?.Groups ?? [])
        {
            <option value="@group.Id" @key="group.Id">@group.Name (@group.Drivers.Count)</option>
        }
    </select>
    <button class="btn" type="button"
            aria-haspopup="dialog" @onclick="() => _managing = true">
        Groups
    </button>
    @if (_error is not null)
    {
        <span class="driver-group-picker__error" role="status">@_error</span>
    }
</div>
<Popup IsOpen="_managing" Title="Driver groups"
       OnClose="() => _managing = false">
    @if (_managing)
    {
        <DriverGroupEditor />
    }
</Popup>
