@{
    RenderFragment detailContent = @<div class="dispatch-load__stop-detail-content">
        @if (!CollapsibleDetails && HasStreet) { <span class="dispatch-load__street">@Stop.Address</span> }
        @if (!string.IsNullOrWhiteSpace(Stop.StopNo)) { <span class="dispatch-load__reference-number">Ref # <strong>@Stop.StopNo</strong></span> }
        @if (AppointmentReferences.Count > 0) { <span class="dispatch-load__appointment-reference">Appt # <strong>@string.Join(", ", AppointmentReferences)</strong></span> }
        @if (HasDisplayEstimate)
        {
            <ArrivalEstimate Stop="PlannedStop" Eta="StopEstimate" DispatchId="DispatchId" Memory="Memory"
                Completed="Completed" Refreshing="Refreshing" ShowDutyStatus="false" ShowAppointment="false" ShowSummary="false" />
            @if (!HasHoursForecast && HasLegacyCycle)
            {
                <div class="dispatch-load__stop-cycle" title="Estimated cycle hours remaining after service at this stop">
                    <span>Cycle after stop</span><strong>@CycleRemaining</strong>
                </div>
            }
        }
        @AdditionalDetails
    </div>;
}

<div class="dispatch-load__stop @(!Detailed ? "dispatch-load__stop--summary" : "") @(Completed ? "dispatch-load__stop--completed" : "")" data-stop-id="@Stop.Id">
    @if (!Detailed && Completed)
    {
        @if (DetailsHref is { } href)
        {
            <a class="btn btn--text dispatch-load__history-stop" href="@href"
               title="@($"{Job} · {VisitLabel} · Completed · {Stop.Address}")">
                <span class="dispatch-load__stop-number"
                      aria-label="@($"Stop {Number}, completed")">@Number</span>
                <span class="dispatch-load__history-check"
                      aria-label="Completed">✓</span>
                <strong class="dispatch-load__location">@Location</strong>
                <span class="dispatch-load__history-time"
                      title="Scheduled appointment">
                    @Client.Services.StopAppointmentDisplay.Format(PlannedStop)
                </span>
            </a>
        }
        else
        {
        <button type="button" class="btn btn--text dispatch-load__history-stop" @onclick="OpenDetails" title="@($"{Job} · {VisitLabel} · Completed · {Stop.Address}")">
            <span class="dispatch-load__stop-number" aria-label="@($"Stop {Number}, completed")">@Number</span>
            <span class="dispatch-load__history-check" aria-label="Completed">✓</span>
            <strong class="dispatch-load__location">@Location</strong>
            <span class="dispatch-load__history-time" title="Scheduled appointment">@Client.Services.StopAppointmentDisplay.Format(PlannedStop)</span>
        </button>
        }
    }
    else
    {
    <div class="dispatch-load__stop-heading">
        <span class="dispatch-load__stop-number" aria-label="@($"Stop {Number}")">@Number</span>
        <span class="dispatch-load__stop-job">@Job</span>
        @if (VisitLabel.Length > 0) { <span class="dispatch-load__stop-visit" title="@($"{VisitLabel} at this address")">@VisitLabel</span> }
        @if (Completed) { <span class="dispatch-load__completed">Completed</span> }
        @if (Stop.DriverOnly) { <span class="dispatch-load__stop-visit" title="Excluded from truck route and fuel; completion is tracked separately">Driver only · No truck</span> }
        else if (Detailed && Stop.StateAfter != "Unknown") { <span class="dispatch-load__stop-visit">After: @Stop.StateAfter</span> }
    </div>
    <strong class="dispatch-load__location" title="@Stop.Name">@Location</strong>
    @if ((!Detailed || CollapsibleDetails) && HasStreet) { <span class="dispatch-load__street">@Stop.Address</span> }
    @if ((Detailed || !HasStreet) && !string.IsNullOrWhiteSpace(Stop.Name)) { <span class="dispatch-load__facility">@Stop.Name</span> }
    <div class="dispatch-load__stop-times">
        @if (PlannedStop.ScheduledDate is null)
        {
            <span class="dispatch-load__appointment">Appointment <strong>—</strong></span>
        }
        <ArrivalEstimate Stop="PlannedStop" Eta="StopEstimate" DispatchId="DispatchId" Memory="Memory"
            Completed="Completed" Refreshing="Refreshing" ShowDutyStatus="false" ShowDetails="false"
            Reading="@StopReading" />
        @if (!Stop.DriverOnly && !Completed && !HasDisplayEstimate)
        {
            <span class="dispatch-load__eta-missing">ETA <strong>—</strong></span>
        }
    </div>
    @if (Detailed && HasDetails)
    {
        @if (OpenDetails.HasDelegate)
        {
            <button type="button" hidden="@DetailsOpen" class="btn btn--text dispatch-load__more-details" @onclick="OpenDetails">More details <span aria-hidden="true">↗</span></button>
            <div hidden="@(!DetailsOpen)">@detailContent</div>
        }
        else if (CollapsibleDetails)
        {
            <details class="dispatch-load__stop-details">
                <summary>More details</summary>
                @detailContent
            </details>
        }
        else { @detailContent }
    }
    @StopActions
    }
</div>
