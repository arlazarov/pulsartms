<section class="fuel-send-plan" role="region" aria-label="Send fuel plan" aria-busy="@(_loading || _saving ? "true" : "false")">
    <header class="fuel-send-plan__header">
        <div><strong class="fuel-send-plan__title">Send fuel plan</strong><span>Truck @TruckNumber</span></div>
        <button type="button" class="btn btn--small" aria-label="Close send fuel plan" disabled="@_saving" @onclick="CloseAsync">×</button>
    </header>
    <div class="fuel-send-plan__body">
        @if (_loading && _preview is null) { <p role="status"><LoadingIndicator /></p> }
        @if (_error is not null)
        {
            <p class="fuel-send-plan__error" role="alert">@_error
                <button type="button" class="btn btn--small" disabled="@(_loading || _saving)" @onclick="LoadAsync">Open the current plan</button>
            </p>
        }
        @if (_preview is { } preview)
        {
            @if (preview.Critical)
            {
                <p class="fuel-send-plan__critical" role="alert">A planned fuel stop is out of reach. Review the fuel plan before sending it.</p>
            }
            <p class="fuel-send-plan__state" role="status">@StateText(preview)</p>
            <h3 class="fuel-send-plan__section">Ready for current shift</h3>
            @if (preview.Lines.Count == 0)
            {
                <p class="fuel-send-plan__empty">No fuel stop is planned for this shift.</p>
            }
            else
            {
                <ol class="fuel-send-plan__lines">
                    @foreach (var line in preview.Lines)
                    {
                        <li @key="line.VisitKey">
                            <span>@line.Text</span>
                            @if (LineLabel(line) is { } label)
                            {
                                <span class="@LineClass(line)">@label</span>
                            }
                        </li>
                    }
                </ol>
            }
            <h3 class="fuel-send-plan__section">Upcoming / provisional</h3>
            <p class="fuel-send-plan__hint">Later fuel stops stay provisional and are not in this message. They are sent when their shift comes.</p>
            <label class="fuel-send-plan__message" for="fuel-send-plan-message">Message to the driver
                <textarea id="fuel-send-plan-message" readonly rows="6" value="@preview.Message"></textarea>
            </label>
            <h3 class="fuel-send-plan__section">WhatsApp</h3>
            <p class="fuel-send-plan__recipient">@RecipientText(preview)</p>
            @if (preview.LastMessage is { } last)
            {
                <p class="@DeliveryClass(last)" role="status">
                    @DeliveryText(last)
                </p>
            }
            @if (preview.Recipient?.DriverId is { } driver
                 && preview.Recipient.State is "noNumber" or "outsideWindow" or "ready")
            {
                <button type="button" class="btn btn--text"
                        aria-expanded="@(_editingContact ? "true" : "false")"
                        @onclick="() => _editingContact = !_editingContact">
                    @(_editingContact ? "Close contacts" : "Edit driver contacts")
                </button>
                @if (_editingContact)
                {
                    <DriverContactEditor DriverId="driver" Saved="ContactSavedAsync" />
                }
            }
            <p class="fuel-send-plan__hint">
                Send via WhatsApp sends this message now. Accepted is not
                delivered: delivery and reading show here when WhatsApp
                reports them. To send it yourself instead, copy the message,
                then mark it as sent. Copying does not mark it sent.
            </p>
            <div class="fuel-send-plan__actions">
                @if (preview.LastMessage is { NeedsConfirmation: true })
                {
                    <button type="button" class="btn btn--primary"
                            disabled="@(!CanSend(preview))"
                            @onclick="() => SendAsync(true)">
                        @(_saving ? "Sending…" : "Send again via WhatsApp")
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn--primary"
                            disabled="@(!CanSend(preview))"
                            @onclick="() => SendAsync(false)">
                        @(_saving ? "Sending…" : "Send via WhatsApp")
                    </button>
                }
                <button type="button" class="btn" disabled="@(_saving)" @onclick="CopyAsync">Copy message</button>
                <button type="button" class="btn" disabled="@(_saving || preview.Lines.Count == 0 || AllSent(preview))" @onclick="MarkSentAsync">
                    Mark as sent
                </button>
                @if (_status is not null) { <span class="fuel-send-plan__status" role="status">@_status</span> }
            </div>
        }
    </div>
</section>
