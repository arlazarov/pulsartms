@* The fuel plan being edited, in the place and shape of the plan it edits:
   one list down the card - the truck, each fuel stop, the load's own stops
   between them - with the chosen stop opened in place for its quantity.
   Nothing is drawn twice and there is no second column to look for
   (the owner, September 26). *@
<section @ref="_surface" class="fuel-plan-editor" role="region"
         aria-label="Edit fuel plan" tabindex="-1" @onkeydown="OnKeyDown"
         aria-busy="@(Busy ? "true" : "false")">
    <header class="fuel-plan-editor__header">
        <div>
            <strong>Fuel plan</strong><span>Truck @TruckNumber</span>
            <small class="fuel-plan-editor__draft">Draft</small>
        </div>
        <button type="button" class="btn btn--small"
                aria-label="Close fuel plan editor" disabled="@_saving"
                @onclick="CloseAsync">×</button>
    </header>
    @if (_errors.Count > 0)
    {
        <div class="fuel-plan-editor__errors" role="alert">
            @foreach (var error in _errors)
            { <p>@RouteMessageDisplay.Concise(error)</p> }
        </div>
    }
    @if (_preview is { } preview)
    {
        <div class="fuel-plan-editor__totals" aria-label="Fuel plan totals">
            <span>Planned fuel <strong>@Quantity(_valuesCurrent
                ? preview.Plan.PurchaseGallons : null) US gal</strong></span>
            <span>Estimated fuel cost <strong>@Money(_valuesCurrent
                ? preview.Plan.PurchaseCostUsd : null) USD</strong></span>
            <span>At finish <strong>@Quantity(_valuesCurrent
                ? preview.Plan.ArrivalGallons : null) US gal</strong></span>
        </div>
    }
    <nav @ref="_stopList" class="fuel-plan-editor__stops"
         aria-label="Route and fuel stops" data-reorder-surface
         data-reorder-axis="vertical">
        @if (_loading)
        {
            <p class="fuel-plan-editor__empty" role="status"><LoadingIndicator /></p>
        }
        else if (_preview is null)
        {
            <button type="button" class="btn" @onclick="LoadAsync">Retry</button>
        }
        else
        {
            <div class="fuel-plan-editor__timeline-heading">
                <strong>Route timeline</strong><small>Drag to reorder</small>
            </div>
            <div class="fuel-plan-editor__origin">
                <ActionIcon Kind="truck" /> Current location
            </div>
            @foreach (var entry in Timeline())
            {
                @if (entry.Fuel is { } row)
                {
                    var stopIndex = _stops.IndexOf(row);
                    var selected = stopIndex == _selected;
                    <div @key="row.Key"
                         class="fuel-plan-editor__stop @(selected ? "is-selected" : "")"
                         data-reorder-key="@entry.Key">
                        <button type="button" class="fuel-plan-editor__grip"
                                data-reorder-handle disabled="@Busy"
                                aria-label="@($"Move {row.Name}")"
                                aria-describedby="fuel-reorder-help"
                                @onkeydown="args => MoveWithKeyboardAsync(row.Key, args)">
                            <svg viewBox="0 0 16 20" aria-hidden="true"><circle cx="5" cy="5" r="1.5" /><circle cx="11" cy="5" r="1.5" /><circle cx="5" cy="10" r="1.5" /><circle cx="11" cy="10" r="1.5" /><circle cx="5" cy="15" r="1.5" /><circle cx="11" cy="15" r="1.5" /></svg>
                        </button>
                        <button type="button" class="fuel-plan-editor__stop-select"
                                aria-pressed="@(selected ? "true" : "false")"
                                disabled="@Busy"
                                @onclick="() => SelectRowAsync(stopIndex)">
                            <span class="fuel-plan-editor__stop-heading">
                                <span class="fleet-fuel-visit__number">@(stopIndex + 1)</span>
                                <ActionIcon Kind="fuel" /><strong>@row.Name</strong>
                            </span>
                            <span class="fuel-plan-editor__stop-meta">
                                <small>@(row.Edit.FillToTarget ? "Full tank"
                                    : $"{Quantity(row.Edit.BuyGallons)} US gal")</small>
                                <small class="fuel-plan-editor__stop-cost">@(CostFor(row) is { } cost
                                    ? $"≈ {Money(cost)} USD" : "Cost —")</small>
                                @if (TankReading(row) is { Length: > 0 } tank)
                                {
                                    <small class="fuel-plan-editor__stop-tank"
                                           title="Tank on arrival and after fueling">@tank</small>
                                }
                            </span>
                        </button>
                        @if (selected)
                        {
                            @* The chosen stop opens under its own line: where it
                               is on the road, the tank around it, and how much
                               to buy there. *@
                            <div class="fuel-plan-editor__detail">
                                <div class="fuel-plan-editor__station-heading">
                                    <div>
                                        <small>Fuel stop @(stopIndex + 1)</small>
                                        @if (SelectedDetails is { } details)
                                        { <p class="fuel-plan-editor__address">@details.Address</p> }
                                        <p class="fuel-plan-editor__position">@PositionFor(row)</p>
                                    </div>
                                    <button type="button" class="btn btn--text"
                                            disabled="@Busy" @onclick="RemoveAsync"
                                            aria-label="Remove selected fuel stop">Remove</button>
                                </div>
                                <div class="fuel-plan-editor__levels"
                                     aria-busy="@(_previewing ? "true" : "false")">
                                    <span>On arrival
                                        <strong>@Level(SelectedResult?.ArrivalGallons)</strong></span>
                                    <span class="fuel-plan-editor__buy">@(row.Edit.FillToTarget ? "Fill up" : "Buy")
                                        <strong>@Quantity(SelectedResult?.BuyGallons) US gal</strong></span>
                                    <span>After fueling
                                        <strong>@Level(SelectedResult?.DepartureGallons)</strong></span>
                                </div>
                                <div class="fuel-plan-editor__quantity">
                                    <div class="fuel-plan-editor__quantity-heading">
                                        <label for="fuel-edit-quantity">Quantity @if (!row.Edit.FillToTarget) { <strong>@Quantity(row.Edit.BuyGallons) US gal</strong> }</label>
                                        <label class="fuel-plan-editor__full"><input type="checkbox" checked="@row.Edit.FillToTarget" disabled="@(Busy || !CanEditQuantity || (row.Edit.FillToTarget && !CanBuyPartial))" @onchange="FullTankAsync" /> Full tank</label>
                                    </div>
                                    <input id="fuel-edit-quantity" type="range" min="25" max="@SliderMaximum" step="5" value="@(row.Edit.FillToTarget ? SliderMaximum : row.SliderGallons)"
                                        aria-label="Gallons to buy" aria-valuetext="@(row.Edit.FillToTarget ? "Full tank" : $"{Quantity(row.SliderGallons)} US gallons")"
                                        disabled="@(Busy || !CanEditQuantity)" title="@(!CanEditQuantity ? "Quantity is unavailable for this route position." : null)" @oninput="QuantityAsync" />
                                    <div class="fuel-plan-editor__range-labels"><span>25 gal</span><span>Full tank</span></div>
                                </div>
                                <div class="fuel-plan-editor__price"><span>Your price</span><strong>@SelectedPrice</strong></div>
                                <div class="fuel-plan-editor__cost"><span>Estimated cost</span><strong>@(CostFor(row) is { } amount ? $"≈ {Money(amount)} USD" : "—")</strong></div>
                            </div>
                        }
                    </div>
                }
                else if (entry.Stop is { } stop)
                {
                    <div @key="entry.Key"
                         class="fuel-plan-editor__anchor @(IsPickup(stop) ? "is-pickup" : "is-delivery")"
                         data-reorder-key="@entry.Key"
                         data-reorder-after="@(entry.Last ? "false" : "true")">
                        <span class="fuel-plan-editor__anchor-symbol" aria-hidden="true">@stop.Sequence</span>
                        <div><small>@StopJob(stop)</small><strong>@stop.Name</strong><span>@stop.DisplayAddress</span></div>
                    </div>
                }
            }
            @if (_stops.Count == 0)
            {
                <p class="fuel-plan-editor__empty">No fuel stops. Select a station on the map to add one.</p>
            }
            <p id="fuel-reorder-help" class="fuel-plan-editor__hint">Use the grip to drag, or focus it and press ↑ / ↓. Select a station on the map to add it here.</p>
            <span class="fuel-plan-editor__announcement" role="status" aria-live="polite" aria-atomic="true">@_orderAnnouncement</span>
        }
    </nav>
    <footer class="fuel-plan-editor__footer">
        <button type="button" class="btn" disabled="@Busy"
            @onclick="ResetAsync">Calculate automatically</button>
        <div><button type="button" class="btn" disabled="@_saving" @onclick="CloseAsync">Cancel</button>
            <button type="button" class="btn btn--primary fuel-plan-editor__save" disabled="@(!CanSave)" @onclick="SaveAsync">Save plan</button></div>
    </footer>
</section>
