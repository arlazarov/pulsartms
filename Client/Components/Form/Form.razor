<EditForm
    Model="@Model"
    OnValidSubmit="SubmitAsync">

    @ChildContent

    <div class="form__actions">
        <button
            class="btn btn--primary"
            type="submit"
            disabled="@IsSaving">
            @(IsSaving ? SavingText : SubmitText)
        </button>

        <button
            class="btn"
            type="button"
            disabled="@IsSaving"
            @onclick="CancelAsync">
            Cancel
        </button>
    </div>

    @if (Errors.Count > 0)
    {
        <div class="form__errors">
            @foreach (var errors in Errors.Values)
            {
                @foreach (var error in errors)
                {
                    <div>@error</div>
                }
            }
        </div>
    }

</EditForm>
