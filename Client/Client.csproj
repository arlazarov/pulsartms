<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ScssSource Include="Styles/**/*.scss" />
    <InternalsVisibleTo Include="Client.Tests" />
  </ItemGroup>

  <Target Name="BuildJavaScript" BeforeTargets="BeforeBuild" Condition="'$(SkipJavaScriptBuild)' != 'true'">
    <Exec Command="npm run js:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="BuildStyles" BeforeTargets="BeforeBuild" Condition="'$(SkipStyleBuild)' != 'true'" Inputs="@(ScssSource);package.json;package-lock.json" Outputs="wwwroot/css/main.css;wwwroot/css/main.css.map">
    <Exec Command="npm run styles:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Target Name="StampStyleVersion" BeforeTargets="BeforeBuild" DependsOnTargets="BuildStyles" Condition="'$(SkipStyleBuild)' != 'true'">
    <Exec Command="node build/styleVersion.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
