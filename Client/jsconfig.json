{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "google.maps"
    ],
    "skipLibCheck": true
  },
  "include": [
    "Scripts/**/*.js",
    "Scripts/**/*.d.ts"
  ]
}
