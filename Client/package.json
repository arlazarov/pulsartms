{
  "name": "amftms-client",
  "private": true,
  "type": "module",
  "scripts": {
    "test:map": "node --test tests/fleetMap/*.test.js",
    "test:styles": "node --test tests/styles/*.test.js",
    "test:identity": "node --test tests/identity/*.test.js",
    "test:dispatch": "node --test tests/dispatch/*.test.js",
    "test:architecture": "node --test tests/architecture/*.test.js",
    "test:browser": "node tests/browser/mapLifecycle.mjs",
    "test:ui": "node tests/browser/uiSmoke.mjs",
    "js:build": "node build/javascript.mjs",
    "js:check": "tsc -p jsconfig.json",
    "map:build": "npm run js:build",
    "styles:build": "sass --style=expanded Styles/main.scss:wwwroot/css/main.css && node build/styleVersion.mjs",
    "styles:watch": "sass --style=expanded --watch Styles/main.scss:wwwroot/css/main.css",
    "test": "node --test tests/fleetMap/*.test.js tests/styles/*.test.js tests/identity/*.test.js tests/dispatch/*.test.js tests/architecture/*.test.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "^1.63.0",
    "sass": "1.83.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@deck.gl/core": "9.1.14",
    "@deck.gl/extensions": "9.1.14",
    "@deck.gl/google-maps": "9.1.14",
    "@deck.gl/layers": "9.1.14"
  }
}
