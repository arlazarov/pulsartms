<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>amftms-api-local</UserSecretsId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="**/gmail-credentials.json;**/gmail-token/**;**/secrets.json;**/appsettings.Local.json;**/.env;**/.env.*" />
    <None Remove="**/gmail-credentials.json;**/gmail-token/**;**/secrets.json;**/appsettings.Local.json;**/.env;**/.env.*" />
  </ItemGroup>

  <Target Name="RejectSecretPublishArtifacts" AfterTargets="Publish">
    <ItemGroup>
      <_SecretPublishArtifacts Include="$(PublishDir)**/gmail-credentials.json;$(PublishDir)**/gmail-token/**;$(PublishDir)**/secrets.json;$(PublishDir)**/appsettings.Local.json;$(PublishDir)**/.env;$(PublishDir)**/.env.*" />
    </ItemGroup>
    <Error Condition="'@(_SecretPublishArtifacts)' != ''"
      Text="Publish output contains credential files. Use a clean output directory and keep credentials outside build artifacts." />
  </Target>

</Project>
